#!/bin/sh
# post-merge
#
# Fires after `git merge` completes — including `git pull` that brings in a merge.
# Reminds you to run the post-merge housekeeping workflow in Claude Code.
# Writes .post-merge-pending so the next Claude Code session detects the gap
# and prompts you to run /post-merge before starting new work.
#
# The reminder runs after successful merges. Guarded merge commits created
# directly by `git merge` also reuse post-commit's progress/footer handling.
#
# To silence on a specific pull: git pull --no-verify

# $1 is 1 if this was a squash merge, 0 otherwise.
# We want to show the reminder on all merge types.

echo ""
echo "  ✔ Merge complete."
echo ""
echo "  → Open Claude Code in this project and run: /post-merge"
echo "    This pulls latest, updates memory, moves the task file, and surfaces what's next."
echo "    Skipping this is how sessions start stale."
echo ""

# Write a flag file so the next Claude Code session detects the skipped /post-merge.
# Resolved via .rigpath if present (external .rig/), otherwise defaults to .rig/.
REPO=$(git rev-parse --show-toplevel 2>/dev/null)
if [ -n "$REPO" ]; then
  # Git does not invoke post-commit for a commit created directly by `git
  # merge`. A successful guarded commit-msg leaves its parent pair in the
  # worktree's Git directory. Claim it once, then reuse post-commit's final
  # SHA/footer handling before writing the post-merge reminder.
  if [ "${RIG_COMMIT_POLICY:-}" = guarded ] && [ "${1:-0}" = 0 ]; then
    MERGE_PROGRESS=$(git -C "$REPO" rev-parse --git-path rig-merge-progress-pending 2>/dev/null) || MERGE_PROGRESS=""
    if [ -n "$MERGE_PROGRESS" ] && [ -f "$MERGE_PROGRESS" ]; then
      MERGE_CLAIM="${MERGE_PROGRESS}.claimed.$$"
      if mv "$MERGE_PROGRESS" "$MERGE_CLAIM" 2>/dev/null; then
        BEFORE_HEAD=$(sed -n '1p' "$MERGE_CLAIM")
        MERGED_HEAD=$(sed -n '2p' "$MERGE_CLAIM")
        rm -f "$MERGE_CLAIM"
        FIRST_PARENT=$(git -C "$REPO" rev-parse 'HEAD^1' 2>/dev/null || true)
        SECOND_PARENT=$(git -C "$REPO" rev-parse 'HEAD^2' 2>/dev/null || true)
        if [ -n "$BEFORE_HEAD" ] && [ "$FIRST_PARENT" = "$BEFORE_HEAD" ] &&
           [ -n "$MERGED_HEAD" ] && [ "$SECOND_PARENT" = "$MERGED_HEAD" ]; then
          HOOK_DIR=$(CDPATH='' cd "$(dirname "$0")" && pwd -P) || HOOK_DIR=""
          if [ -n "$HOOK_DIR" ] && [ -x "$HOOK_DIR/post-commit" ] && [ -f "$HOOK_DIR/post-commit" ]; then
            (cd "$REPO" && "$HOOK_DIR/post-commit") ||
              echo "WARNING: The Rig could not run post-commit after the guarded merge; review PROGRESS.md." >&2
          else
            echo "WARNING: The Rig post-commit hook is unavailable after the guarded merge; review PROGRESS.md." >&2
          fi
        fi
      fi
    fi
  fi
  if [ -f "$REPO/.rigpath" ]; then
    RIG_DIR=$(tr -d '[:space:]' < "$REPO/.rigpath")
  else
    RIG_DIR="$REPO/.rig"
  fi
  if [ -d "$RIG_DIR/memory" ]; then
    MERGE_SHA=$(git -C "$REPO" rev-parse HEAD 2>/dev/null || printf 'unknown')
    MERGED_AT=$(date -Iseconds 2>/dev/null || date '+%Y-%m-%dT%H:%M:%S' 2>/dev/null || printf 'unknown')
    PENDING="$RIG_DIR/memory/.post-merge-pending"
    PENDING_TMP="${PENDING}.tmp.$$"
    if printf 'merge_sha=%s\nmerged_at=%s\nanchor=%s\n' "$MERGE_SHA" "$MERGED_AT" "${RIG_SESSION_ANCHOR:-}" > "$PENDING_TMP"; then
      mv "$PENDING_TMP" "$PENDING"
      if [ -x "$REPO/bin/rig" ] && { [ -n "${RIG_SESSION_FILE:-}" ] || [ -n "${RIG_SESSION_ANCHOR:-}" ]; }; then
        "$REPO/bin/rig" session obligation mark --kind post-merge --merge-sha "$MERGE_SHA" --json >/dev/null 2>&1 || true
      fi
    else
      rm -f "$PENDING_TMP"
    fi
  fi
fi
