#!/bin/sh
# commit-msg
#
# 1. Strips auto-injected tool footers (Co-Authored-By, Made-with-Claude, etc.)
#    to keep history clean and human-authored in tone.
# 2. Validates Conventional Commits subject-line format.
# 3. Requires an issue/ticket reference in the subject line, format depending on
#    issue-tracking: and optional issue-ref-pattern: in CLAUDE.md.
#
# To disable format/ticket validation: set SKIP_COMMIT_VALIDATION=1 before committing.
# This never bypasses commit approval or the base-branch policy.
# To disable footer stripping: remove or comment out the filter block below.
# To skip the issue reference check for a single commit (no ticket exists):
#   add  # no-issue  as a line in the commit message body.

# PreToolUse invokes this with a dedicated argument to check compatibility.
# Git passes the prepared message file as $1 during a real commit.
if [ "${1:-}" = --rig-policy-probe ]; then
  printf '%s\n' 'rig-commit-policy-v1'
  exit 0
fi

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
COMMIT_MSG_FILE="$1"
REPLAY=0
if [ -d "$(git rev-parse --git-path rebase-merge)" ] || \
   [ -d "$(git rev-parse --git-path rebase-apply)" ] || \
   [ -f "$(git rev-parse --git-path CHERRY_PICK_HEAD)" ] || \
   [ -f "$(git rev-parse --git-path REVERT_HEAD)" ] || \
   [ -d "$(git rev-parse --git-path sequencer)" ]; then
  REPLAY=1
fi
if [ "${RIG_COMMIT_POLICY:-}" = guarded ] && [ "$REPLAY" -eq 0 ]; then
  MERGE_PENDING=$(git rev-parse --git-path rig-merge-progress-pending) || exit 1
  rm -f "$MERGE_PENDING" || exit 1
  RIG_DIR=$(python3 "$ROOT/bin/rig-path.py" "$ROOT") || exit 1
  case "$RIG_DIR" in
    /*) ;;
    *) echo "ERROR: The Rig .rigpath must contain an absolute directory." >&2; exit 1 ;;
  esac
  COMMIT_OK="$RIG_DIR/memory/.rig-commit-ok"
  TTL="${RIG_COMMIT_OK_TTL_SECONDS:-900}"
  case "$TTL" in
    ''|*[!0-9]*) echo "ERROR: Invalid commit approval lifetime." >&2; exit 1 ;;
  esac
  if [ ! -f "$COMMIT_OK" ]; then
    echo "ERROR: Commit blocked by The Rig. Approval is missing: $COMMIT_OK" >&2
    exit 1
  fi
  NOW=$(date +%s) || exit 1
  MTIME=$(stat -c %Y "$COMMIT_OK" 2>/dev/null || stat -f %m "$COMMIT_OK" 2>/dev/null) || exit 1
  case "$NOW:$MTIME" in
    *[!0-9:]*) echo "ERROR: Commit approval timestamp could not be verified." >&2; exit 1 ;;
  esac
  AGE=$((NOW - MTIME))
  if [ "$AGE" -lt 0 ] || [ "$AGE" -gt "$TTL" ]; then
    rm -f "$COMMIT_OK"
    echo "ERROR: Commit approval is stale; request fresh approval." >&2
    exit 1
  fi
  # Claim before any message/branch validation. A rejected attempt also spends
  # approval, and only one concurrent hook can move this source file.
  CLAIM="$COMMIT_OK.claimed-$$"
  mv "$COMMIT_OK" "$CLAIM" 2>/dev/null || {
    echo "ERROR: Commit approval was already claimed." >&2
    exit 1
  }
  rm -f "$CLAIM" || exit 1

fi

# A generated `git merge` runs commit-msg and post-merge, but not post-commit.
# Leave a worktree-specific marker only after this hook has accepted the merge.
# Manual conflict completion runs post-commit, which clears the marker itself.
accept_commit() {
  if [ "${RIG_COMMIT_POLICY:-}" = guarded ] && [ "$REPLAY" -eq 0 ]; then
    MERGE_HEAD_PATH=$(git rev-parse --git-path MERGE_HEAD) || exit 1
    if [ -f "$MERGE_HEAD_PATH" ]; then
      BEFORE_HEAD=$(git rev-parse HEAD) || exit 1
      IFS= read -r MERGED_HEAD < "$MERGE_HEAD_PATH" || exit 1
      [ -n "$MERGED_HEAD" ] || exit 1
      PENDING_TMP="${MERGE_PENDING}.tmp.$$"
      if ! printf '%s\n%s\n' "$BEFORE_HEAD" "$MERGED_HEAD" > "$PENDING_TMP" ||
         ! mv "$PENDING_TMP" "$MERGE_PENDING"; then
        rm -f "$PENDING_TMP"
        echo "ERROR: The Rig could not record the guarded merge for progress logging." >&2
        exit 1
      fi
    fi
  fi
  exit 0
}

HOOK_DIR="$(CDPATH='' cd "$(dirname "$0")" && pwd -P)" || exit 1
FILTER="$HOOK_DIR/filter-commit-message-inplace.sh"
[ -f "$FILTER" ] || FILTER="${ROOT}/.husky/filter-commit-message-inplace.sh"

# ── Step 1: Strip tool-injected footers ──────────────────────────────────────
if [ -f "$FILTER" ]; then
  sh "$FILTER" "$COMMIT_MSG_FILE" || exit 1
else
  echo "ERROR: The Rig commit-message filter is missing: $FILTER" >&2
  exit 1
fi

# ── Step 2: Guard the actual branch using the prepared subject ──────────────
SUBJECT=$(head -1 "$COMMIT_MSG_FILE" | sed 's/\r//')
if [ "${RIG_COMMIT_POLICY:-}" = guarded ] && [ "$REPLAY" -eq 0 ]; then
  BRANCH=$(git symbolic-ref --quiet --short HEAD 2>/dev/null || true)
  # Protect main, master, and every base-branch: value CLAUDE.md configures
  # (issue #659); a configured `develop` base is a base branch too.
  PROTECTED_BRANCH="$BRANCH"
  if [ -n "$BRANCH" ] &&
     sed -n 's/^base-branch:[[:space:]]*\([^[:space:]#][^[:space:]#]*\).*/\1/p' "$ROOT/CLAUDE.md" 2>/dev/null |
       sed -e 's/^"\(..*\)"$/\1/' -e "s/^'\(..*\)'\$/\1/" |
       grep -Fxq -- "$BRANCH"; then
    PROTECTED_BRANCH=main
  fi
  case "$PROTECTED_BRANCH" in
    main|master)
      HOUSEKEEPING=$(sed -n 's/^housekeeping:[[:space:]]*\([^[:space:]#]*\).*/\1/p' "$ROOT/CLAUDE.md" 2>/dev/null | head -1)
      if [ "$HOUSEKEEPING" != direct-push ]; then
        echo "ERROR: Commit to '$BRANCH' blocked by The Rig; create a feature branch." >&2
        exit 1
      fi
      if ! printf '%s\n' "$SUBJECT" | grep -Eq '^(chore|docs)(\([^)]*\))?: .+'; then
        echo "ERROR: Direct-to-$BRANCH commit blocked; only chore/docs subjects are allowed." >&2
        exit 1
      fi
      ;;
  esac

fi

# ── Step 3: Validate Conventional Commits format ─────────────────────────────
[ "${SKIP_COMMIT_VALIDATION:-0}" = "1" ] && accept_commit

# Skip validation for auto-generated commit types
case "$SUBJECT" in
  "Merge "* | "Revert "* | "fixup! "* | "squash! "* | "Initial commit"*)
    accept_commit ;;
esac

VALID_TYPES="feat|fix|chore|refactor|docs|test|perf|devops|style"
if ! echo "$SUBJECT" | grep -qE "^($VALID_TYPES)(\(.+\))?: .+"; then
  echo ""
  echo "ERROR: Commit message does not follow Conventional Commits format."
  echo "  Expected: type(scope): description"
  echo "  Types:    feat | fix | chore | refactor | docs | test | perf | devops | style"
  echo "  Got:      $SUBJECT"
  echo ""
  echo "  To bypass: SKIP_COMMIT_VALIDATION=1 git commit ..."
  echo ""
  exit 1
fi

# ── Step 4: Require issue/ticket reference based on issue-tracking setting ───
CLAUDE_MD="${ROOT}/CLAUDE.md"
TRACKER_CONFIG="${ROOT}/bin/rig-tracker-config.py"

# Allow the # no-issue trailer to skip the ref check for any tracker.
# Used when a commit legitimately has no associated ticket (e.g. one-off fixes,
# chores on personal projects with issue-tracking: github but no issue worth
# opening). Add  # no-issue  as a standalone line in the commit body.
if grep -q "^# no-issue" "$COMMIT_MSG_FILE" 2>/dev/null; then
  accept_commit
fi

if [ ! -f "$TRACKER_CONFIG" ] || ! python3 "$TRACKER_CONFIG" validate-subject "$CLAUDE_MD" "$SUBJECT"; then
  echo "  Got: $SUBJECT" >&2
  echo "  Per-commit bypass: add # no-issue as a line in the commit body" >&2
  exit 1
fi

accept_commit
