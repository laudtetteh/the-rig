#!/usr/bin/env bash
set -euo pipefail

readonly RIG_EXIT_USAGE=64
readonly RIG_EXIT_UNAVAILABLE=69

usage() { cat <<'EOF'
Usage: rig <command> [subcommand] [options]

Commands:
  rig doctor                Diagnose a Rig installation
  rig connector preflight   Check declared connector dependencies
  rig worktree bootstrap    Restore missing stealth artifacts in a linked worktree
  rig session resolve       Resolve the current session identity
  rig session current       Show the exact current session safely
  rig session list          List redacted public session summaries
  rig session doctor        Check session-record integrity and privacy
  rig session repair        Preview or confirm explicit orphan repair
  rig session retrofit      Bind this process' native session ID safely
  rig session obligation    Mark or clear an exact session obligation
  rig sprint                Audit, plan, or inspect a durable sprint
  rig session-name set      Set the current session name atomically
  rig memory validate       Validate Rig memory files
  rig memory repair-markers Reposition unambiguous Rig memory markers
  rig memory append-gap     Append one structured Rig gap
  rig memory append-progress Append one dated progress entry
  rig memory write-snapshot Atomically replace CONTEXT_SNAPSHOT.md
  rig codex                 Launch Codex with Rig context
  rig claude                Launch Claude Code with Rig context
  rig version               Print the installed Rig version
EOF
}
json_requested() { local arg; for arg in "$@"; do [[ "$arg" == --json ]] && return 0; done; return 1; }
rig_root() {
  local script_root cwd_root script_common cwd_common
  script_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
  cwd_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
  [[ -n "$cwd_root" ]] && cwd_root="$(cd "$cwd_root" && pwd -P)"
  if [[ -n "$cwd_root" ]]; then
    script_common="$(git -C "$script_root" rev-parse --git-common-dir 2>/dev/null || true)"
    cwd_common="$(git -C "$cwd_root" rev-parse --git-common-dir 2>/dev/null || true)"
    [[ -n "$script_common" ]] && script_common="$(cd "$script_root" && cd "$script_common" && pwd -P)"
    [[ -n "$cwd_common" ]] && cwd_common="$(cd "$cwd_root" && cd "$cwd_common" && pwd -P)"
    [[ -n "$script_common" && "$script_common" == "$cwd_common" ]] && { printf '%s\n' "$cwd_root"; return; }
  fi
  printf '%s\n' "$script_root"
}
rig_dir() {
  local root path; root="$(rig_root)"
  if [[ -f "$root/.rigpath" ]]; then
    IFS= read -r path < "$root/.rigpath" || true
    if [[ -n "$path" ]]; then case "$path" in /*) printf '%s\n' "$path";; *) printf '%s\n' "$root/$path";; esac; return; fi
  fi
  printf '%s\n' "$root/.rig"
}
version() {
  local value=unknown file; file="$(rig_dir)/VERSION"
  [[ -f "$file" ]] && { IFS= read -r value < "$file" || true; }; [[ -n "$value" ]] || value=unknown
  if json_requested "$@"; then printf '{"version":"%s"}\n' "$value"; else printf 'The Rig v%s\n' "$value"; fi
}
command_help() {
  case "$1" in
    doctor) printf 'Usage: rig doctor [--json]\n';;
    connector) printf 'Usage: rig connector preflight --skill ID [--evidence FILE|-] [--refresh] [--json]\n';;
    worktree) printf 'Usage: rig worktree bootstrap\n';;
    session) cat <<'EOF'
Usage: rig session <resolve|current|list|doctor|repair|retrofit|obligation> [options]

Native IDs are redacted unless --verbose is explicitly supplied.
Repair is preview-only unless --confirm TOKEN and --reason REASON are supplied.
Retrofit binds the current native host ID from env with no transcript matching.
Content matching is never part of normal resolution.
EOF
      ;;
    session-name) printf 'Usage: rig session-name set [--tentative|--final] [--complete] [--json] <name>\n';;
    sprint) printf 'Usage: rig sprint <audit|plan|status> [options] --json\n';;
    memory) cat <<'EOF'
Usage: rig memory <validate|repair-markers|append-gap|append-progress|write-snapshot> [options]

Append helpers resolve .rigpath before writing and use atomic file replacement
where replacement is required.
EOF
      ;;
    codex) printf 'Usage: rig codex [-- <codex arguments>]\n';;
    claude) printf 'Usage: rig claude [-- <claude arguments>]\n';;
  esac
}

worktree_bootstrap() {
  [[ "${1:-}" == bootstrap && "$#" -eq 1 ]] || { usage_error "usage: rig worktree bootstrap" "$@"; return; }
  local root common primary
  root="$(rig_root)"
  common="$(git -C "$root" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || { echo "Not a Git worktree." >&2; return "$RIG_EXIT_UNAVAILABLE"; }
  primary="$(dirname "$common")"
  [[ "$root" != "$primary" && -f "$primary/.rigpath" ]] || { echo "No primary stealth worktree found." >&2; return "$RIG_EXIT_UNAVAILABLE"; }
  python3 - "$primary" "$root" <<'PY'
import pathlib, shutil, sys
source, target = map(pathlib.Path, sys.argv[1:])
paths = [".rigpath","CLAUDE.md","PROJECT_BRIEF.md",".gitleaks.toml","bin/rig",
         ".claude",".agents",".codex",".mcp.json",".playwright-mcp",".github",
         "docs/INDEX.md","docs/features/README.md"]
# Linked worktrees live under the primary's own .claude/worktrees/ (see the
# stealth CLAUDE.md's off-limits note on that path), so copying ".claude"
# whole would recurse into every sibling worktree checkout nested there --
# including, self-referentially, the very worktree this run is bootstrapping.
# shutil.copytree re-scans each directory as it descends rather than
# snapshotting the whole tree upfront, so once it reaches that self-reference
# it keeps finding its own just-written output as new input: the destination
# grows a nested .claude/worktrees/<name>/.claude/worktrees/<name>/... chain
# with no natural base case, consuming disk until a filesystem limit (e.g.
# ENAMETOOLONG) finally aborts it. Reproduced live: ~110MB and 30+ directory
# levels in under 2 minutes from a single bootstrap call with sibling
# worktrees already present. "worktrees" is never itself a stealth artifact
# to restore -- each linked worktree bootstraps its own independently -- so
# it is always excluded from every directory copy here, not just ".claude"'s.
ignore_worktrees = shutil.ignore_patterns("worktrees")
copied=[]
for rel in paths:
    src, dst = source/rel, target/rel
    if not src.exists() or src.is_symlink() or dst.exists(): continue
    dst.parent.mkdir(parents=True, exist_ok=True)
    shutil.copytree(src,dst,ignore=ignore_worktrees) if src.is_dir() else shutil.copy2(src,dst)
    copied.append(rel)
print("Bootstrapped linked worktree: " + (", ".join(copied) if copied else "already complete"))
PY
}

session_obligation() {
  local action="${1:-}" kind="" merge_sha="" adopt=false json=false arg resolved file anchor
  shift || true
  while [[ "$#" -gt 0 ]]; do
    arg="$1"
    case "$arg" in
      --kind) [[ "$#" -ge 2 ]] || { usage_error "--kind requires a value" "$@"; return; }; kind="$2"; shift 2;;
      --merge-sha) [[ "$#" -ge 2 ]] || { usage_error "--merge-sha requires a value" "$@"; return; }; merge_sha="$2"; shift 2;;
      --adopt-legacy) adopt=true; shift;;
      --json) json=true; shift;;
      *) usage_error "unknown obligation option: $arg" "$@"; return;;
    esac
  done
  [[ "$action" == mark || "$action" == clear ]] || { usage_error "obligation action must be mark or clear"; return; }
  [[ "$kind" == wrap || "$kind" == post-merge ]] || { usage_error "obligation kind must be wrap or post-merge"; return; }
  [[ "$kind" != post-merge || -n "$merge_sha" ]] || { usage_error "post-merge obligation requires --merge-sha"; return; }
  resolved=$(session_resolve --json) || return $?
  file=$(printf '%s' "$resolved" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("session_file") or "")')
  anchor=$(printf '%s' "$resolved" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("anchor") or "")')
  [[ -n "$file" && -n "$anchor" ]] || return "$RIG_EXIT_UNAVAILABLE"
  RIG_DIR="$(rig_dir)" SESSION_F="$file" SESSION_ANCHOR="$anchor" OBLIGATION_ACTION="$action" OBLIGATION_KIND="$kind" MERGE_SHA="$merge_sha" ADOPT_LEGACY="$adopt" python3 <<'PY'
import datetime, fcntl, json, os, pathlib, tempfile
rig=pathlib.Path(os.environ["RIG_DIR"]); memory=rig/"memory"; memory.mkdir(parents=True,exist_ok=True)
p=pathlib.Path(os.environ["SESSION_F"]); anchor=os.environ["SESSION_ANCHOR"]
action=os.environ["OBLIGATION_ACTION"]; kind=os.environ["OBLIGATION_KIND"]
merge_sha=os.environ.get("MERGE_SHA",""); adopt=os.environ.get("ADOPT_LEGACY")=="true"
marker=memory/(".wrap-needed" if kind=="wrap" else ".post-merge-pending")
global_lock=open(memory/".session-obligations.lock","a+"); fcntl.flock(global_lock.fileno(),fcntl.LOCK_EX)
record_lock=open(str(p)+".lock","a+"); fcntl.flock(record_lock.fileno(),fcntl.LOCK_EX)
with open(p) as f: d=json.load(f)
if d.get("schema_version")!=1 or d.get("anchor")!=anchor:
    print(json.dumps({"ok":False,"reason":"record_changed","no_write":True})); raise SystemExit(3)
now=datetime.datetime.now(datetime.timezone.utc).astimezone().isoformat(timespec="seconds")
raw=marker.read_text() if marker.exists() else ""
cleared_global=False
if kind=="wrap":
    scoped=[]; legacy=[]
    for line in raw.splitlines():
        if line.startswith("anchor="): scoped.append(line[7:])
        elif line.strip(): legacy.append(line)
    if action=="mark":
        if anchor not in scoped: scoped.append(anchor)
    else:
        if anchor not in scoped and (legacy or marker.exists()) and not adopt:
            print(json.dumps({"ok":False,"reason":"legacy_adoption_required","no_write":True})); raise SystemExit(3)
        scoped=[value for value in scoped if value!=anchor]
        if adopt: legacy=[]
    content="".join("anchor="+value+"\n" for value in scoped)+"".join(value+"\n" for value in legacy)
else:
    values={}
    for line in raw.splitlines():
        if "=" in line:
            key,value=line.split("=",1); values[key]=value
    if action=="mark":
        values.update({"merge_sha":merge_sha,"anchor":anchor})
    else:
        if not marker.exists() or values.get("merge_sha")!=merge_sha:
            print(json.dumps({"ok":False,"reason":"merge_mismatch","no_write":True})); raise SystemExit(3)
        values={}
    content="".join(key+"="+values[key]+"\n" for key in ("merge_sha","merged_at","anchor") if values.get(key))
def write_marker():
    global cleared_global
    if content:
        fd,tmp=tempfile.mkstemp(prefix=marker.name+".tmp.",dir=str(memory))
        with os.fdopen(fd,"w") as f: f.write(content); f.flush(); os.fsync(f.fileno())
        os.replace(tmp,marker)
    else:
        try: marker.unlink(); cleared_global=True
        except FileNotFoundError: cleared_global=True
# Mark reminder-first so a crash cannot hide pending work. Clear record-first so
# a crash can leave only a harmless stale reminder, never a lost obligation.
if action=="mark": write_marker()
flags=d.setdefault("flags",{}); obligations=d.setdefault("obligations",{})
if kind=="wrap":
    flags["wrap_needed"]=(action=="mark")
    obligations["wrap"]={"pending":action=="mark","marked_at":now if action=="mark" else obligations.get("wrap",{}).get("marked_at"),"cleared_at":now if action=="clear" else None}
else:
    flags["post_merge_pending"]=(action=="mark")
    obligations["post_merge"]={"pending":action=="mark","merge_sha":merge_sha,"acknowledged_at":now if action=="clear" else None}
d["updated_at"]=now; d["revision"]=int(d.get("revision",0))+1
fd,tmp=tempfile.mkstemp(prefix=".session-",suffix=".tmp",dir=str(p.parent))
with os.fdopen(fd,"w") as f: json.dump(d,f,indent=2); f.write("\n"); f.flush(); os.fsync(f.fileno())
os.replace(tmp,p)
if action=="clear": write_marker()
print(json.dumps({"ok":True,"anchor":anchor,"kind":kind,"action":action,"cleared_global":cleared_global,"revision":d["revision"]}))
PY
}
unavailable() { local command="$1"; shift; if json_requested "$@"; then printf '{"ok":false,"command":"%s","error":"not_implemented"}\n' "$command"; else printf 'rig: %s is not implemented in this version\n' "$command" >&2; fi; return "$RIG_EXIT_UNAVAILABLE"; }
usage_error() { local message="$1"; shift; if json_requested "$@"; then printf '{"ok":false,"error":"usage","message":"%s"}\n' "$message"; else printf 'rig: %s\nTry "rig --help" for usage.\n' "$message" >&2; fi; return "$RIG_EXIT_USAGE"; }

memory_markers() {
  local action="$1" arg
  shift
  for arg in "$@"; do
    [[ "$arg" == --json ]] || { usage_error "unknown memory option: $arg" "$@"; return; }
  done
  RIG_DIR="$(rig_dir)" MEMORY_ACTION="$action" python3 - "$@" <<'PY'
import json, os, pathlib, re, stat, sys, tempfile

rig_dir = pathlib.Path(os.environ["RIG_DIR"])
action = os.environ["MEMORY_ACTION"]
json_output = "--json" in sys.argv[1:]
date_heading = re.compile(r"^##\s+(?:\[)?(\d{4}-\d{2}-\d{2})(?:\])?(?:\s|$)")

specs = (
    ("PROGRESS.md", "<!-- Add entries above this line, newest first -->", "above"),
    ("ERRORS.md", "<!-- Add new entries below this line, newest first -->", "below"),
)

def inspect(name, marker, direction):
    path = rig_dir / "memory" / name
    result = {"file": name, "ok": False, "marker_line": None,
              "first_entry_line": None, "issues": []}
    try:
        text = path.read_text()
    except OSError as exc:
        result["issues"].append("unreadable: " + str(exc))
        return path, None, result, None

    lines = text.splitlines(keepends=True)
    marker_indexes = [i for i, line in enumerate(lines) if line.rstrip("\r\n") == marker]
    marker_like = [i for i, line in enumerate(lines)
                   if "Add " in line and "entries" in line and "newest first" in line]
    format_indexes = []
    entries = []
    fenced = False
    for index, line in enumerate(lines):
        stripped = line.rstrip("\r\n")
        if stripped.startswith("```"):
            fenced = not fenced
            continue
        if fenced:
            continue
        if stripped == "## Format":
            format_indexes.append(index)
        match = date_heading.match(stripped)
        if match:
            entries.append((index, match.group(1)))

    if len(marker_indexes) != 1:
        result["issues"].append("marker_missing" if not marker_indexes else "marker_duplicated")
    if len(marker_like) != len(marker_indexes):
        result["issues"].append("marker_ambiguous")
    if len(format_indexes) != 1:
        result["issues"].append("format_missing" if not format_indexes else "format_duplicated")

    marker_index = marker_indexes[0] if len(marker_indexes) == 1 else None
    format_index = format_indexes[0] if len(format_indexes) == 1 else None
    result["marker_line"] = marker_index + 1 if marker_index is not None else None
    result["first_entry_line"] = entries[0][0] + 1 if entries else None

    if format_index is not None and marker_index is not None and marker_index <= format_index:
        result["issues"].append("marker_before_format")
    if entries:
        if format_index is not None and entries[0][0] <= format_index:
            result["issues"].append("entry_before_format")
        if marker_index is not None:
            indexes = [item[0] for item in entries]
            correctly_placed = marker_index > max(indexes) if direction == "above" else marker_index < min(indexes)
            if not correctly_placed:
                result["issues"].append("marker_mispositioned")
        dates = [item[1] for item in entries]
        if dates != sorted(dates, reverse=True):
            result["issues"].append("entries_not_newest_first")

    result["ok"] = not result["issues"]
    return path, lines, result, (marker_index, format_index, entries, marker)

def repair(path, lines, result, parsed):
    if result["ok"] or lines is None or parsed is None:
        return False
    marker_index, format_index, entries, marker = parsed
    repairable = result["issues"] == ["marker_mispositioned"]
    if not repairable or marker_index is None or format_index is None or not entries:
        return False

    marker_line = lines.pop(marker_index)
    if not marker_line.endswith(("\n", "\r")):
        newline = "\r\n" if any(line.endswith("\r\n") for line in lines) else "\n"
        marker_line += newline
    entry_indexes = [index - (1 if index > marker_index else 0) for index, _ in entries]
    if path.name == "PROGRESS.md":
        target = len(lines)
        for index in range(max(entry_indexes) + 1, len(lines)):
            if lines[index].startswith("## "):
                target = index
                break
    else:
        target = min(entry_indexes)
    lines.insert(target, marker_line)

    original_mode = stat.S_IMODE(path.stat().st_mode)
    fd, temporary = tempfile.mkstemp(prefix=".memory-marker-", dir=path.parent)
    try:
        with os.fdopen(fd, "w") as handle:
            handle.writelines(lines)
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(temporary, original_mode)
        os.replace(temporary, path)
    finally:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass
    return True

inspections = []
for name, marker, direction in specs:
    inspections.append(inspect(name, marker, direction))

changed = []
if action == "repair-markers":
    safe = all(result["ok"] or result["issues"] == ["marker_mispositioned"]
               for _, _, result, _ in inspections)
    if safe:
        for path, lines, result, parsed in inspections:
            if repair(path, lines, result, parsed):
                changed.append(path.name)

results = [inspect(name, marker, direction)[2] for name, marker, direction in specs]

ok = all(result["ok"] for result in results)
payload = {"ok": ok, "command": "memory " + action, "changed": changed, "files": results}
if json_output:
    print(json.dumps(payload, separators=(",", ":")))
else:
    for result in results:
        if result["ok"]:
            print("PASS  " + result["file"])
        else:
            print("WARN  " + result["file"] + ": " + ", ".join(result["issues"]))
    if changed:
        print("Repositioned markers: " + ", ".join(changed))
raise SystemExit(0 if ok else 1)
PY
}

memory_append_gap() {
  RIG_DIR="$(rig_dir)" python3 - "$@" <<'PY'
import datetime, fcntl, json, os, pathlib, sys, tempfile

args = sys.argv[1:]
def take(name, default=""):
    if name not in args:
        return default
    index = args.index(name)
    if index + 1 >= len(args):
        print(json.dumps({"ok": False, "reason": "invalid_input", "message": name + " requires a value"}))
        raise SystemExit(64)
    return args[index + 1]
json_output = "--json" in args
recognized = {"--title", "--scope", "--category", "--severity", "--workflow", "--observation", "--suggested-fix", "--json"}
bad = [arg for arg in args if arg.startswith("--") and arg not in recognized]
if bad:
    print(json.dumps({"ok": False, "reason": "invalid_input", "message": "unknown option: " + bad[0]}))
    raise SystemExit(64)
title = take("--title").strip()
scope = take("--scope", "project").strip()
category = take("--category", "workflow").strip()
severity = take("--severity", "medium").strip()
workflow = take("--workflow", "unspecified").strip()
observation = take("--observation").strip()
suggested = take("--suggested-fix", "Needs triage.").strip()
if not title or not observation or scope not in ("project", "rig-core"):
    print(json.dumps({"ok": False, "reason": "invalid_input", "message": "title, observation, and scope project|rig-core are required"}))
    raise SystemExit(64)
today = datetime.date.today().isoformat()
entry = f"""## [{today}] — {title}

**Category**: {category}
**Severity**: {severity}
**Scope**: {scope}
**Workflow**: {workflow}

**Observation**:
{observation}

**Suggested fix**:
{suggested}

"""
memory = pathlib.Path(os.environ["RIG_DIR"]) / "memory"
memory.mkdir(parents=True, exist_ok=True)
path = memory / "RIG_GAPS.md"
lock_path = memory / ".rig-gaps.lock"
with open(lock_path, "a+") as lock:
    fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
    existing = path.read_text() if path.exists() else "# Rig Gaps\n\n"
    if not existing.endswith("\n"):
        existing += "\n"
    fd, tmp = tempfile.mkstemp(prefix=".rig-gaps-", suffix=".tmp", dir=str(memory))
    try:
        with os.fdopen(fd, "w") as handle:
            handle.write(existing)
            if not existing.endswith("\n\n"):
                handle.write("\n")
            handle.write(entry)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(tmp, path)
    finally:
        try:
            os.unlink(tmp)
        except FileNotFoundError:
            pass
payload = {"ok": True, "file": str(path), "scope": scope, "title": title}
if json_output:
    print(json.dumps(payload, separators=(",", ":")))
else:
    print("Appended Rig gap: " + title)
PY
}

memory_append_progress() {
  RIG_DIR="$(rig_dir)" python3 - "$@" <<'PY'
import datetime, fcntl, json, os, pathlib, sys, tempfile

args = sys.argv[1:]
json_output = "--json" in args
def take(name, default=""):
    if name not in args:
        return default
    index = args.index(name)
    if index + 1 >= len(args):
        print(json.dumps({"ok": False, "reason": "invalid_input", "message": name + " requires a value"}))
        raise SystemExit(64)
    return args[index + 1]
recognized = {"--title", "--body", "--sid", "--json"}
bad = [arg for arg in args if arg.startswith("--") and arg not in recognized]
if bad:
    print(json.dumps({"ok": False, "reason": "invalid_input", "message": "unknown option: " + bad[0]}))
    raise SystemExit(64)
title = take("--title").strip()
body = take("--body").strip()
sid = take("--sid").strip()
if not title or not body:
    print(json.dumps({"ok": False, "reason": "invalid_input", "message": "title and body are required"}))
    raise SystemExit(64)
memory = pathlib.Path(os.environ["RIG_DIR"]) / "memory"
memory.mkdir(parents=True, exist_ok=True)
path = memory / "PROGRESS.md"
lock_path = memory / ".progress.lock"
today = datetime.date.today().isoformat()
sid_suffix = f" <!-- sid:{sid} -->" if sid else ""
entry = f"## [{today}] — {title}{sid_suffix}\n\n{body}\n\n"
with open(lock_path, "a+") as lock:
    fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
    text = path.read_text() if path.exists() else "# Progress\n\n## Format\n\n"
    marker = "<!-- Add entries above this line, newest first -->"
    if marker in text:
        text = text.replace(marker, entry + marker, 1)
    else:
        text = text.rstrip() + "\n\n" + entry
    fd, tmp = tempfile.mkstemp(prefix=".progress-", suffix=".tmp", dir=str(memory))
    try:
        with os.fdopen(fd, "w") as handle:
            handle.write(text)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(tmp, path)
    finally:
        try:
            os.unlink(tmp)
        except FileNotFoundError:
            pass
payload = {"ok": True, "file": str(path), "title": title, "sid": sid or None}
print(json.dumps(payload, separators=(",", ":")) if json_output else "Appended progress entry: " + title)
PY
}

memory_write_snapshot() {
  local from_file="" json=false arg
  while [[ "$#" -gt 0 ]]; do
    arg="$1"
    case "$arg" in
      --file) [[ "$#" -ge 2 ]] || { usage_error "--file requires a value" "$@"; return; }; from_file="$2"; shift 2;;
      --stdin) from_file="-"; shift;;
      --json) json=true; shift;;
      *) usage_error "unknown memory option: $arg" "$@"; return;;
    esac
  done
  [[ -n "$from_file" ]] || { usage_error "write-snapshot requires --file FILE or --stdin" "$@"; return; }
  RIG_DIR="$(rig_dir)" SNAPSHOT_SOURCE="$from_file" SNAPSHOT_JSON="$json" python3 <<'PY'
import json, os, pathlib, stat, sys, tempfile

source = os.environ["SNAPSHOT_SOURCE"]
if source == "-":
    content = sys.stdin.read()
else:
    source_path = pathlib.Path(source)
    if not source_path.is_file():
        print(json.dumps({"ok": False, "reason": "source_missing"}))
        raise SystemExit(1)
    content = source_path.read_text()
memory = pathlib.Path(os.environ["RIG_DIR"]) / "memory"
memory.mkdir(parents=True, exist_ok=True)
path = memory / "CONTEXT_SNAPSHOT.md"
mode = stat.S_IMODE(path.stat().st_mode) if path.exists() else 0o644
fd, tmp = tempfile.mkstemp(prefix=".context-snapshot-", suffix=".tmp", dir=str(memory))
try:
    with os.fdopen(fd, "w") as handle:
        handle.write(content)
        if content and not content.endswith("\n"):
            handle.write("\n")
        handle.flush()
        os.fsync(handle.fileno())
    os.chmod(tmp, mode)
    os.replace(tmp, path)
finally:
    try:
        os.unlink(tmp)
    except FileNotFoundError:
        pass
payload = {"ok": True, "file": str(path)}
print(json.dumps(payload, separators=(",", ":")) if os.environ["SNAPSHOT_JSON"] == "true" else "Wrote CONTEXT_SNAPSHOT.md")
PY
}

doctor() {
  local arg
  for arg in "$@"; do
    [[ "$arg" == --json ]] || { usage_error "unknown doctor option: $arg" "$@"; return; }
  done
  RIG_ROOT="$(rig_root)" RIG_DIR="$(rig_dir)" python3 - "$@" <<'PY'
import hashlib, json, os, pathlib, re, shlex, stat, subprocess, sys

try:
    import tomllib
except ImportError:
    tomllib = None

root = pathlib.Path(os.environ["RIG_ROOT"])
rig = pathlib.Path(os.environ["RIG_DIR"])
checks = []

def check(name, ok, detail):
    checks.append({"name": name, "ok": bool(ok), "detail": str(detail)})

def read(path):
    try:
        return path.read_text(errors="replace")
    except OSError:
        return ""

def run(command):
    try:
        return subprocess.run(command, cwd=root, text=True, capture_output=True, timeout=10)
    except (OSError, subprocess.SubprocessError) as exc:
        return None

def project_identity():
    try:
        common = subprocess.check_output(["git", "-C", str(root), "rev-parse", "--git-common-dir"], text=True, stderr=subprocess.DEVNULL).strip()
        common = pathlib.Path(common if os.path.isabs(common) else root / common).resolve()
        return hashlib.sha256(str(common).encode()).hexdigest()
    except (OSError, subprocess.SubprocessError):
        return hashlib.sha256(str(root.resolve()).encode()).hexdigest()

common = run(["git", "rev-parse", "--path-format=absolute", "--git-common-dir"])
if common is not None and common.returncode == 0:
    primary = pathlib.Path(common.stdout.strip()).parent
    if primary != root and (primary / ".rigpath").exists():
        required = [".rigpath", "CLAUDE.md", "bin/rig", ".claude"]
        missing = [p for p in required if not (root / p).exists()]
        recovery = f"cd {shlex.quote(str(root))} && {shlex.quote(str(primary / 'bin/rig'))} worktree bootstrap"
        check("worktree_bootstrap", not missing, "complete" if not missing else "missing: " + ", ".join(missing) + "; recover: " + recovery)

# Path resolution must be both usable and recognisably a Rig data directory.
marker = rig / "memory"
check("rig_directory", rig.is_dir() and os.access(rig, os.R_OK) and marker.is_dir(),
      f"resolved {rig}" if rig.is_dir() else f"missing {rig}")
rigpath = root / ".rigpath"
if rigpath.exists():
    raw_text = read(rigpath)
    raw = raw_text.strip()
    check("rigpath", bool(raw) and len(raw_text.splitlines()) == 1 and rig.is_dir(),
          f"resolves to {rig}" if raw else "empty .rigpath")
else:
    check("rigpath", rig == root / ".rig", "using local .rig")

# Stealth exclusions are required only for stealth installs. Future Codex paths
# become required when the corresponding integration is detectable.
if rigpath.exists():
    exclude_path = run(["git", "rev-parse", "--git-path", "info/exclude"])
    resolved_exclude = pathlib.Path(exclude_path.stdout.strip()) if exclude_path is not None and exclude_path.returncode == 0 else root / ".git" / "info" / "exclude"
    if not resolved_exclude.is_absolute(): resolved_exclude = root / resolved_exclude
    exclude = read(resolved_exclude).splitlines()
    entries = {line.strip().rstrip("/") for line in exclude if line.strip() and not line.lstrip().startswith("#")}
    required = ["CLAUDE.md", "PROJECT_BRIEF.md", ".claude", ".rigpath"]
    for candidate in [".agents", ".codex", ".mcp.json", ".playwright-mcp"]:
        if (root / candidate).exists(): required.append(candidate)
    missing = [item for item in required if item.rstrip("/") not in entries]
    check("stealth_exclusions", not missing, "complete" if not missing else "missing: " + ", ".join(missing))
else:
    check("stealth_exclusions", True, "not a stealth install")

json_files = [root / ".claude" / "settings.json"]
hooks = root / ".codex" / "hooks.json"
if hooks.exists(): json_files.append(hooks)
bad_json = []
for path in json_files:
    try:
        with path.open() as handle: json.load(handle)
    except (OSError, ValueError) as exc:
        bad_json.append(f"{path.relative_to(root)}: {exc}")
check("settings_json", not bad_json, "valid" if not bad_json else "; ".join(bad_json))

# The per-install manifest records exactly which optional commands were selected.
manifest = rig / "memory" / ".rig-manifest"
expected = []
for line in read(manifest).splitlines():
    fields = line.split(None, 1)
    if len(fields) == 2 and fields[1].startswith(".claude/commands/") and fields[1].endswith(".md"):
        expected.append(fields[1])
command_dir = root / ".claude" / "commands"
if expected:
    missing = [item for item in expected if not (root / item).is_file()]
    detail = f"{len(expected) - len(missing)}/{len(expected)} manifest commands present"
else:
    present = sorted(command_dir.glob("*.md")) if command_dir.is_dir() else []
    missing = [] if present else [".claude/commands/*.md"]
    detail = f"{len(present)} commands present (no manifest baseline)"
check("claude_commands", not missing, detail if not missing else "missing: " + ", ".join(missing))

skills = root / ".agents" / "skills"
if skills.is_dir():
    command_names = {p.stem for p in command_dir.glob("*.md")}
    skill_names = {p.parent.name for p in skills.glob("*/SKILL.md")}
    missing_skills = sorted(command_names - skill_names)
    extra_skills = sorted(skill_names - command_names)
    check("codex_skill_parity", not missing_skills and not extra_skills,
          f"{len(skill_names)}/{len(command_names)} mirrored" if not missing_skills and not extra_skills
          else "missing skills: " + (", ".join(missing_skills) or "none") + "; extra skills: " + (", ".join(extra_skills) or "none"))
else:
    check("codex_skill_parity", True, "Codex mirroring not enabled")

# Codex target metadata makes project-instruction visibility a required health
# check. AGENTS.override.md and AGENTS.md take precedence; CLAUDE.md is effective
# only when the project config names it as a fallback.
target_state = rig / "install-targets.json"
try:
    target_agents = json.loads(read(target_state)).get("agents", [])
except (AttributeError, TypeError, ValueError):
    target_agents = []
if "codex" in target_agents:
    agents_file = next((name for name in ("AGENTS.override.md", "AGENTS.md")
                        if (root / name).is_file()), None)
    fallback_ok = False
    config_error = None
    config_path = root / ".codex" / "config.toml"
    if tomllib is not None and os.environ.get("_RIG_TEST_NO_TOMLLIB") != "1":
        try:
            with config_path.open("rb") as handle:
                fallback_names = tomllib.load(handle).get("project_doc_fallback_filenames", [])
            fallback_ok = isinstance(fallback_names, list) and "CLAUDE.md" in fallback_names and (root / "CLAUDE.md").is_file()
        except (OSError, tomllib.TOMLDecodeError) as exc:
            config_error = str(exc)
    else:
        config_text = read(config_path)
        table_match = re.search(r'(?m)^[ \t]*\[', config_text)
        matches = list(re.finditer(r'(?ms)^[ \t]*project_doc_fallback_filenames[ \t]*=[ \t]*\[(.*?)\]', config_text))
        match = matches[0] if len(matches) == 1 else None
        top_level = match is not None and (table_match is None or match.start() < table_match.start())
        if top_level:
            fallback_names = re.findall(r'["\']([^"\']+)["\']', match.group(1))
            fallback_ok = "CLAUDE.md" in fallback_names and (root / "CLAUDE.md").is_file()
        else:
            config_error = "top-level project_doc_fallback_filenames missing, nested, or malformed"
    effective = bool(agents_file) or fallback_ok
    if agents_file:
        detail = f"{agents_file} takes precedence"
    elif fallback_ok:
        detail = "CLAUDE.md loaded through project_doc_fallback_filenames"
    else:
        detail = "no effective AGENTS file or CLAUDE.md fallback"
        if config_error:
            detail += ": " + config_error
    check("codex_project_instructions", effective, detail)
else:
    check("codex_project_instructions", True, "Codex project target not enabled")

codex_runtime_id = os.environ.get("CODEX_THREAD_ID", "")
if codex_runtime_id:
    required_codex = []
    if "codex" not in target_agents:
        required_codex.append("install-targets.json lacks codex")
    if not (root / ".codex" / "hooks.json").is_file():
        required_codex.append(".codex/hooks.json missing")
    adapter_path = root / ".codex" / "hooks" / "rig-adapter.sh"
    if not adapter_path.is_file():
        required_codex.append(".codex/hooks/rig-adapter.sh missing")
    elif not os.access(adapter_path, os.X_OK):
        required_codex.append(".codex/hooks/rig-adapter.sh not executable")
    if not (root / ".codex" / "config.toml").is_file():
        required_codex.append(".codex/config.toml missing")
    if not skills.is_dir():
        required_codex.append(".agents/skills missing")
    target_detail = ("Codex project runtime support present" if not required_codex else
                     "missing: " + ", ".join(required_codex) +
                     "; converge with /rig-upgrade --scope=project --mode=agent or install.sh --project-only --project-agent both --strategy merge")
    check("codex_project_target_runtime", not required_codex, target_detail)

    session_root = rig / "memory" / "sessions"
    records = []
    session_errors = []
    for base in (session_root, session_root / "done"):
        if not base.is_dir():
            continue
        for path in base.glob("session-*.json"):
            try:
                data = json.loads(read(path))
                if isinstance(data, dict):
                    records.append((path, data))
                else:
                    session_errors.append(path.name)
            except (ValueError, TypeError):
                session_errors.append(path.name)
    current_project_id = project_identity()
    same = [(p, d) for p, d in records
            if d.get("schema_version") == 1
            and d.get("project", {}).get("identity") == current_project_id
            and d.get("agent") == "codex"
            and d.get("native", {}).get("session_id") == codex_runtime_id]
    cross = [(p, d) for p, d in records
             if d.get("schema_version") == 1
             and d.get("project", {}).get("identity") != current_project_id
             and d.get("agent") == "codex"
             and d.get("native", {}).get("session_id") == codex_runtime_id]
    if session_errors:
        session_ok, session_detail = False, "session records malformed: " + ", ".join(session_errors[:5])
    elif len(same) > 1:
        session_ok, session_detail = False, "duplicate Codex native bindings"
    elif same:
        path, data = same[0]
        if "done" in path.parts or data.get("lifecycle", {}).get("state") == "complete":
            session_ok, session_detail = False, "current Codex thread is bound only to a completed record"
        else:
            session_ok, session_detail = True, "current Codex thread has an active Rig session binding"
    elif cross:
        session_ok, session_detail = False, "current Codex thread is bound to another project"
    else:
        session_ok = False
        session_detail = "current Codex thread is not bound; run: bin/rig session retrofit --agent codex --from-env --source resume --json"
    check("codex_session_runtime", session_ok, session_detail)
else:
    check("codex_project_target_runtime", True, "Codex runtime not detected")
    check("codex_session_runtime", True, "Codex runtime not detected")

claude_md = read(root / "CLAUDE.md")
matches = re.findall(r"(?m)^issue-tracking:\s*([^\s#]+)", claude_md)
tracker = matches[-1].lower() if matches else "github"
supported = {"github", "linear", "trello", "gus", "none"}
check("issue_tracking", len(matches) <= 1 and tracker in supported,
      f"configured: {tracker}" if tracker in supported else f"unsupported: {tracker}")

if tracker == "github":
    auth = run(["gh", "auth", "status"])
    authenticated = auth is not None and auth.returncode == 0
    check("github_auth", authenticated, "authenticated" if authenticated else "gh authentication unavailable")
else:
    check("github_auth", True, f"not required for {tracker}")

# Command guidance is checked separately from repository history: command files
# must describe the selected tracker, while commits use the generic reference
# syntax. PR titles are not required to carry commit-only [#N] suffixes.
guidance = read(command_dir / "task.md") + "\n" + read(command_dir / "ship.md")
tokens = {"github": "issue-tracking: github", "linear": "issue-tracking: linear",
          "trello": "issue-tracking: trello", "gus": "issue-tracking: gus", "none": "issue-tracking: none"}
check("tracker_command_guidance", tokens.get(tracker, "") in guidance,
      f"command guidance covers {tracker}" if tokens.get(tracker, "") in guidance else f"command guidance missing {tracker}")

log = run(["git", "log", "-20", "--pretty=%s"])
subjects = log.stdout.splitlines() if log is not None and log.returncode == 0 else []
if tracker == "github": pattern = re.compile(r"\[#\d+\]")
elif tracker == "linear": pattern = re.compile(r"\b[A-Z][A-Z0-9]+-\d+\b")
elif tracker == "trello": pattern = re.compile(r"\btrello:[A-Za-z0-9_-]+\b", re.I)
elif tracker == "gus": pattern = re.compile(r"\bW-\d+\b", re.I)
else: pattern = None
if pattern and subjects:
    drift = [subject for subject in subjects if not pattern.search(subject)]
    check("recent_commit_references", not drift, f"{len(subjects)-len(drift)}/{len(subjects)} match {tracker}; first drift: {drift[0]}" if drift else f"{len(subjects)}/{len(subjects)} match {tracker}")
else:
    check("recent_commit_references", True, "no convention required" if pattern is None else "no commits to inspect")

# Query PRs only when this is a GitHub-backed checkout and auth already passed;
# this avoids surprising network activity in ordinary local/non-GitHub projects.
remote = run(["git", "remote", "get-url", "origin"])
remote_url = remote.stdout.strip() if remote is not None and remote.returncode == 0 else ""
if tracker == "github" and "github.com" in remote_url and authenticated:
    prs = run(["gh", "pr", "list", "--state", "all", "--limit", "20", "--json", "title,body"])
    try:
        pr_data = json.loads(prs.stdout) if prs is not None and prs.returncode == 0 else None
    except (TypeError, ValueError):
        pr_data = None
    if pr_data is None:
        check("recent_pr_references", False, "unable to inspect GitHub PRs")
    else:
        # A project may use conventional PR titles without the commit-only [#N]
        # suffix. Accept an issue reference or close keyword in either title/body.
        unlinked = [pr.get("title", "") for pr in pr_data
                    if not re.search(r"(?i)(?:\[#\d+\]|\b(?:closes|fixes|resolves)\s+#\d+\b)",
                                     pr.get("title", "") + "\n" + (pr.get("body") or ""))]
        check("recent_pr_references", not unlinked,
              f"{len(pr_data)-len(unlinked)}/{len(pr_data)} linked; first drift: {unlinked[0]}" if unlinked else f"{len(pr_data)}/{len(pr_data)} linked")
else:
    reason = "not a GitHub remote" if tracker == "github" else f"not required for {tracker}"
    check("recent_pr_references", True, reason)

# Connector declarations are local configuration only. Doctor validates the
# public envelope but never promotes them to schema-visible or callable: those
# stages require sanitized evidence from the exact active agent session.
connector_declaration = rig / "connectors" / "skill-dependencies.v1.json"
if connector_declaration.exists():
    try:
        connector_data = json.loads(read(connector_declaration))
        connector_ok = (connector_data.get("schema") == "https://the-rig.dev/schemas/skill-connector-dependencies/v1"
                        and connector_data.get("schema_version") == 1
                        and isinstance(connector_data.get("skills"), list)
                        and isinstance(connector_data.get("providers"), dict)
                        and isinstance(connector_data.get("smoke_checks"), dict))
    except (AttributeError, TypeError, ValueError):
        connector_ok = False
    check("connector_declarations", connector_ok,
          "configured; session evidence required for schema visibility and callability" if connector_ok else "invalid declaration")

# CLAUDE.md/PROJECT_BRIEF.md placeholder gate: a historical installer bug
# (v1.10.0, fixed v1.10.1 / commit 28b8756, issue #140) could silently reset
# these user-owned files to the raw template when no manifest entry existed
# yet. A git-tracked project shows this in `git status`; a stealth/external
# install (CLAUDE.md/PROJECT_BRIEF.md are git-excluded there) has no such
# signal at all. This gate can't tell "never filled in" from "reset by that
# bug" — both look identical on disk — so it reports as a soft, advisory
# finding rather than claiming certainty. See docs/lessons-learned.md #14.
_placeholder_markers = {
    "CLAUDE.md": "[One paragraph: what it does, who it's for, and why it exists.]",
    "PROJECT_BRIEF.md": '[What does this product do? Complete this sentence: "A tool that helps [who] [do what]."]',
}
_placeholder_hits = []
for _fname, _marker in _placeholder_markers.items():
    _fpath = root / _fname
    if _fpath.is_file() and _marker in read(_fpath):
        _placeholder_hits.append(_fname)
if _placeholder_hits:
    check("template_placeholder_content", False,
          f"still shows the raw template placeholder: {', '.join(_placeholder_hits)} — "
          "either never filled in, or possibly reset by a historical upgrade bug "
          "(docs/lessons-learned.md #14); worth a manual check, especially for stealth installs where git can't show a diff")
else:
    check("template_placeholder_content", True, "no unfilled core-content placeholders detected")

# ── Postflight/release gates (#444 lane 444-H) ─────────────────────────────────
# These gates make "the upgrade succeeded" a verifiable claim: manifest
# provenance, stealth-status, mode/hash drift, and stale-state detection.
#
# installer/validate-manifest-provenance.py (444-B / #448) and
# installer/audit-stealth.py (444-D / #449) are release-engineering tools that
# live in The Rig's own source repo, not artifacts shipped into downstream
# target projects (nothing under templates/ copies an installer/ directory
# into an installed project). They can only be found here when this doctor
# run is itself operating inside a colocated checkout of the source repo
# (The Rig dogfooding itself) or when _RIG_INSTALLER_DIR names their
# directory explicitly (used by tests and any future explicit wiring). In an
# ordinary downstream install neither script will ever be found, and both
# gates below correctly and permanently report "skipped" rather than
# "failed" — that is expected steady state, not a gap.
def find_installer_script(name):
    candidates = []
    override = os.environ.get("_RIG_INSTALLER_DIR")
    if override:
        candidates.append(pathlib.Path(override) / name)
    candidates.append(root / "installer" / name)
    candidates.append(rig / "installer" / name)
    for candidate in candidates:
        if candidate.is_file():
            return candidate
    return None

manifest_metadata = rig / "memory" / ".rig-manifest.json"

# Manifest provenance gate: delegates to validate-manifest-provenance.py when
# present. Malformed base_revision/generator/provider values are reported as
# failures; entries that simply predate provenance tracking (legacy/unknown)
# are surfaced in the detail text but do not fail the check on their own.
# Since issue #463, the installed project's own .rig/VERSION is passed as
# --running-version so the validator can additionally flag an entry whose
# base_revision claims an installer VERSION newer than what is actually
# installed here — an impossible/bogus state, reported as a distinct
# future_revision finding and treated as a failure, same as malformed.
provenance_script = find_installer_script("validate-manifest-provenance.py")
if provenance_script is None:
    check("manifest_provenance", True,
          "skipped: installer/validate-manifest-provenance.py not present (activates once #448 merges/is colocated)")
elif not manifest_metadata.is_file():
    check("manifest_provenance", True, "skipped: no manifest metadata file present")
else:
    provenance_command = ["python3", str(provenance_script), str(manifest_metadata)]
    installed_version_file = rig / "VERSION"
    installed_version = read(installed_version_file).strip() if installed_version_file.is_file() else ""
    if installed_version:
        provenance_command += ["--running-version", installed_version]
    provenance_run = run(provenance_command)
    if provenance_run is None:
        check("manifest_provenance", False, "validator failed to execute")
    else:
        try:
            provenance_payload = json.loads(provenance_run.stdout)
        except ValueError:
            provenance_payload = None
        if provenance_payload is None:
            check("manifest_provenance", False,
                  f"validator produced invalid output (exit {provenance_run.returncode}): {provenance_run.stderr.strip()}")
        elif provenance_run.returncode == 2:
            check("manifest_provenance", False,
                  "manifest metadata invalid: " + provenance_payload.get("error", {}).get("message", "unknown"))
        else:
            malformed = provenance_payload.get("malformed", [])
            legacy = provenance_payload.get("legacy_provenance", [])
            future = provenance_payload.get("future_revision", [])
            detail = f"{provenance_payload.get('checked', 0)} entries checked"
            if malformed:
                first = malformed[0]
                fields = ", ".join(p.get("field", "") for p in first.get("problems", []))
                detail += f"; malformed: {first.get('path')} ({fields})"
                if len(malformed) > 1:
                    detail += f" and {len(malformed) - 1} more"
            elif future:
                first = future[0]
                detail += (f"; future base_revision: {first.get('path')} "
                           f"({first.get('base_revision')} > {first.get('running_version')})")
                if len(future) > 1:
                    detail += f" and {len(future) - 1} more"
            elif legacy:
                detail += f"; {len(legacy)} legacy/unknown-provenance entr{'y' if len(legacy) == 1 else 'ies'} (not an error)"
            check("manifest_provenance", provenance_payload.get("ok", False), detail)

# Stealth-status gate: delegates to audit-stealth.py when present. Reports
# tracked_leak/untracked_leak findings as failures; a non-stealth project (no
# .rigpath) or an unreadable non-primary git dir (e.g. a linked worktree,
# which audit-stealth.py cannot classify) is reported as skipped, not failed.
stealth_script = find_installer_script("audit-stealth.py")
if stealth_script is None:
    check("stealth_status", True,
          "skipped: installer/audit-stealth.py not present (activates once #449 merges/is colocated)")
else:
    stealth_run = run(["python3", str(stealth_script), str(root)])
    if stealth_run is None:
        check("stealth_status", False, "audit failed to execute")
    else:
        try:
            stealth_payload = json.loads(stealth_run.stdout)
        except ValueError:
            stealth_payload = None
        if stealth_payload is None:
            check("stealth_status", False,
                  f"audit produced invalid output (exit {stealth_run.returncode}): {stealth_run.stderr.strip()}")
        elif stealth_run.returncode == 2:
            err = stealth_payload.get("error", {})
            if err.get("code") == "not-a-git-repo":
                check("stealth_status", True, "skipped: not a primary git repository")
            else:
                check("stealth_status", False, "audit error: " + err.get("message", "unknown"))
        elif not stealth_payload.get("stealth", False):
            check("stealth_status", True, stealth_payload.get("message", "not a stealth/external install"))
        else:
            leaks = [a for a in stealth_payload.get("artifacts", [])
                     if a.get("status") in ("tracked_leak", "untracked_leak")]
            if leaks:
                detail = f"{stealth_payload.get('leak_count', len(leaks))} leak(s): " + \
                    ", ".join(f"{a['path']} ({a['status']})" for a in leaks[:5])
                if len(leaks) > 5:
                    detail += f" and {len(leaks) - 5} more"
            else:
                detail = "no leaks detected"
            check("stealth_status", stealth_payload.get("ok", False), detail)

# Manifest mode/hash drift + stale-state gates share one parse of the
# manifest metadata JSON (schema_version 1, entries: relpath -> {sha256,
# owner, source, type, mode, ...}). check-capabilities.py only runs
# capability-manifest smoke checks (exists/executable/json-key/command
# against installer/capabilities.v1.json) — it has no notion of the
# per-artifact install manifest, so this is new logic, not a duplicate.
if manifest_metadata.is_file():
    try:
        manifest_json = json.loads(read(manifest_metadata))
        manifest_entries = manifest_json.get("entries")
        if not isinstance(manifest_entries, dict):
            raise ValueError("entries is not an object")
    except (ValueError, AttributeError):
        manifest_entries = None

    if manifest_entries is None:
        check("manifest_mode_hash", False, "manifest metadata file is not valid JSON")
        check("stale_manifest_entries", False, "manifest metadata file is not valid JSON")
    else:
        def path_is_safe(rel):
            return isinstance(rel, str) and rel and not rel.startswith("/") and ".." not in rel.split("/")

        # Manifest relpaths are recorded relative to the logical .rig/ root,
        # not the project root. In stealth/external mode .rig/ is physically
        # rig_dir() (RIG_DIR, resolved via .rigpath), not root/.rig — mirrors
        # install.sh's report_stale_manifest_entries() resolve() helper.
        def resolve_artifact(rel):
            if rel == ".rig" or rel.startswith(".rig/"):
                stripped = rel[len(".rig/"):] if rel.startswith(".rig/") else ""
                return (rig / stripped) if stripped else rig
            return root / rel

        # Mode/hash drift: only Rig-owned entries are meaningful here. A
        # hash/mode mismatch on a user-owned (customized) file is expected
        # behaviour, not drift, and upgrade already has its own customization
        # workflow for those — this gate exists to catch Rig-owned files that
        # were hand-edited outside the installer.
        drift = []
        drift_checked = 0
        for rel in sorted(manifest_entries):
            entry = manifest_entries[rel]
            if not path_is_safe(rel) or not isinstance(entry, dict) or entry.get("owner") != "rig":
                continue
            drift_checked += 1
            artifact = resolve_artifact(rel)
            if not artifact.exists() and not artifact.is_symlink():
                drift.append(f"{rel}: missing")
                continue
            expected_hash = entry.get("sha256")
            if expected_hash and artifact.is_file() and not artifact.is_symlink():
                try:
                    actual_hash = hashlib.sha256(artifact.read_bytes()).hexdigest()
                except OSError:
                    actual_hash = None
                if actual_hash is not None and actual_hash != expected_hash:
                    drift.append(f"{rel}: hash mismatch")
                    continue
            expected_mode = entry.get("mode")
            if expected_mode:
                try:
                    actual_mode = format(stat.S_IMODE(artifact.lstat().st_mode), "o")
                except OSError:
                    actual_mode = None
                if actual_mode is not None and str(actual_mode) != str(expected_mode):
                    drift.append(f"{rel}: mode {actual_mode} != {expected_mode}")
        if drift_checked:
            mode_hash_detail = f"{drift_checked - len(drift)}/{drift_checked} rig-owned artifacts match manifest"
            if drift:
                mode_hash_detail += "; drift: " + ", ".join(drift[:5])
                if len(drift) > 5:
                    mode_hash_detail += f" and {len(drift) - 5} more"
            check("manifest_mode_hash", not drift, mode_hash_detail)
        elif manifest_entries:
            # The manifest has entries but none are Rig-owned. For any
            # actually-installed Rig project this is suspicious — dozens of
            # Rig-owned files always exist. Silently passing here would be
            # the same "no evidence recorded, so assume safe" anti-pattern
            # already fixed elsewhere (issue #470/#471) — surface it as a
            # failure instead of folding it into a vacuous pass alongside
            # the genuine "no manifest file at all yet" case below.
            check("manifest_mode_hash", False,
                  "manifest has entries but none are Rig-owned — unexpected for an installed Rig project")
        else:
            check("manifest_mode_hash", True, "no rig-owned manifest entries to check")

        # Stale-state: any manifest entry (any owner) whose artifact no longer
        # exists on disk at all. This mirrors report_stale_manifest_entries()'s
        # own existence-check logic in install.sh (same path-safety filter,
        # same os.path.lexists semantics), reimplemented directly here rather
        # than shelling out to install.sh: that function is gated on
        # in-progress upgrade state ($COLLISION_STRATEGY, $REPAIR_STALE, a
        # live $TARGET) that doctor does not have and should not fabricate.
        stale = [rel for rel in sorted(manifest_entries)
                 if path_is_safe(rel) and not resolve_artifact(rel).exists() and not resolve_artifact(rel).is_symlink()]
        if stale:
            stale_detail = f"{len(stale)} stale entr{'y' if len(stale) == 1 else 'ies'}: " + ", ".join(stale[:5])
            if len(stale) > 5:
                stale_detail += f" and {len(stale) - 5} more"
        else:
            stale_detail = "no stale entries"
        check("stale_manifest_entries", not stale, stale_detail)
else:
    check("manifest_mode_hash", True, "skipped: no manifest metadata file present")
    check("stale_manifest_entries", True, "skipped: no manifest metadata file present")

# Idempotence gate: doctor is a read-only diagnostic and deliberately never
# re-invokes the installer against a live project tree (there is no safe way
# to snapshot/roll back a real target from inside a read-only command, and
# bin/rig has no recorded path back to the install.sh that produced it once
# installed). Idempotence is instead proven by a dedicated test that runs
# install.sh twice against a disposable fixture and asserts the second run
# changes nothing: tests/test_install_idempotence.bats. This check always
# reports the documented procedure rather than silently claiming a live
# verification that did not happen.
check("idempotence", True,
      "not verified live (would require mutating the live project tree from a read-only command); "
      "run: bats tests/test_install_idempotence.bats")

# ── Post-upgrade validation against known historical bug patterns (issue #473) ──
# Diffs the most recent #472 pre-flight snapshot against current state for a
# small, deliberately narrow set of patterns that are genuinely expressible as
# a before/after file diff. Embedded here rather than a separate file under
# installer/, because bin/rig is a self-contained script copied into every
# target project -- it has no access back to the installer's own source repo
# once deployed. Most of docs/lessons-learned.md's entries are process/
# environment lessons (worktree confusion, hook mistiming, migration typos)
# with no file-content signature to check; only two meet that bar today.
# Designed to grow as more diffable patterns are identified.
def _latest_preflight_snapshot():
    if rigpath.exists():
        snap_root = rig / "preflight-snapshots"
    else:
        snap_root = root / ".rig-backup" / "preflight-snapshots"
    if not snap_root.is_dir():
        return None
    candidates = sorted((p for p in snap_root.iterdir() if p.is_dir()), key=lambda p: p.name)
    return candidates[-1] if candidates else None

snapshot_dir = _latest_preflight_snapshot()
if snapshot_dir is None:
    check("upgrade_pattern_blanked_file", True, "no pre-flight snapshot found (issue #472) -- nothing to compare yet")
    check("upgrade_pattern_symlink_replaced", True, "no pre-flight snapshot found (issue #472) -- nothing to compare yet")
else:
    # Lesson #14: a file that had already been personalized (its
    # "[Project Name]" placeholder substituted at install time) reverted to
    # raw, unsubstituted template content after an upgrade. Coverage is
    # asymmetric between the two files: install.sh substitutes
    # "[Project Name]" in CLAUDE.md on every install/upgrade run, but never
    # touches PROJECT_BRIEF.md's own copy of that placeholder -- so this
    # check only fires for PROJECT_BRIEF.md if a user manually edited that
    # exact title line away from the placeholder themselves. Not a false
    # positive risk, just weaker practical coverage for that one file.
    blanked = []
    for rel_name in ("CLAUDE.md", "PROJECT_BRIEF.md"):
        before_path = snapshot_dir / rel_name
        after_path = root / rel_name
        if not before_path.is_file() or not after_path.is_file():
            continue
        if "[Project Name]" not in read(before_path) and "[Project Name]" in read(after_path):
            blanked.append(rel_name)
    check("upgrade_pattern_blanked_file", not blanked,
          "none detected" if not blanked else
          "reverted to raw template (lesson #14): " + ", ".join(blanked))

    # Lesson #15: a path that was a symlink before the upgrade now exists as
    # a regular file -- the exact signature of a symlink-refusal guard being
    # bypassed and its target silently overwritten in place.
    replaced = []
    try:
        snapshot_paths = list(snapshot_dir.rglob("*"))
    except OSError:
        snapshot_paths = []
    for before_path in snapshot_paths:
        if not before_path.is_symlink():
            continue
        rel = before_path.relative_to(snapshot_dir)
        # External/stealth snapshots nest the external .rig/ dir's own
        # contents under a top-level ".rig" name (see #472) -- map those
        # back to the real external location, not $TARGET/.rig.
        if rigpath.exists() and rel.parts and rel.parts[0] == ".rig":
            after_path = rig.joinpath(*rel.parts[1:])
        else:
            after_path = root / rel
        if after_path.is_file() and not after_path.is_symlink():
            replaced.append(str(rel))
    check("upgrade_pattern_symlink_replaced", not replaced,
          "none detected" if not replaced else
          "symlink silently replaced by a regular file (lesson #15): " + ", ".join(replaced))

result = {"ok": all(item["ok"] for item in checks), "command": "doctor", "root": str(root), "rig_dir": str(rig), "checks": checks}
if "--json" in sys.argv[1:]:
    print(json.dumps(result, separators=(",", ":")))
else:
    for item in checks:
        print(("PASS" if item["ok"] else "FAIL") + f"  {item['name']}: {item['detail']}")
    print("Rig doctor: " + ("healthy" if result["ok"] else "problems found"))
raise SystemExit(0 if result["ok"] else 1)
PY
}

session_resolve() {
  RIG_ROOT="$(rig_root)" RIG_DIR="$(rig_dir)" python3 - "$@" <<'PY'
import hashlib, json, os, pathlib, subprocess, sys
root = pathlib.Path(os.environ["RIG_ROOT"])
session_dir = pathlib.Path(os.environ["RIG_DIR"]) / "memory" / "sessions"
args = sys.argv[1:]
def confined_session_path(value):
    """Return a canonical session path only when it stays in sessions/."""
    if not value:
        return None
    try:
        candidate = pathlib.Path(value)
        if not candidate.is_absolute():
            candidate = pathlib.Path.cwd() / candidate
        sessions_root = session_dir.resolve()
        resolved = candidate.resolve(strict=False)
        resolved.relative_to(sessions_root)
        if resolved == sessions_root:
            return None
        # Reject symlinks in the file path, including dangling final links.
        probe = candidate
        while True:
            if probe.is_symlink():
                if probe == candidate:
                    return None
                try:
                    probe.resolve(strict=False).relative_to(sessions_root)
                    return None
                except ValueError:
                    pass
            if probe.parent == probe:
                break
            probe = probe.parent
        if candidate.exists() and not candidate.is_file():
            return None
        return resolved
    except (OSError, ValueError, RuntimeError):
        return None
def option(name):
    try: return args[args.index(name) + 1]
    except (ValueError, IndexError): return ""
agent, native_id = option("--agent"), option("--native-session-id")
verbose = "--verbose" in args
def project_identity():
    try:
        common = subprocess.check_output(["git", "-C", str(root), "rev-parse", "--git-common-dir"], text=True, stderr=subprocess.DEVNULL).strip()
        common = pathlib.Path(common if os.path.isabs(common) else root / common).resolve()
        return hashlib.sha256(str(common).encode()).hexdigest()
    except (OSError, subprocess.SubprocessError):
        return hashlib.sha256(str(root.resolve()).encode()).hexdigest()
project_id = project_identity()
def load(path):
    try:
        data = json.loads(path.read_text())
        if not isinstance(data, dict): return None
        return data
    except (OSError, ValueError, TypeError): return None
def emit(path, data, confidence, reason):
    lifecycle = data.get("lifecycle", {}) if data else {}
    out = {"ok": confidence == "exact", "schema_version": 1,
           "session_file": str(path) if path else None, "anchor": data.get("anchor") if data else None,
           "agent": data.get("agent") if data else None,
           "branch": (data.get("runtime", {}).get("branch") or data.get("branch")) if data else None,
           "state": lifecycle.get("state", data.get("status")) if data else None,
           "confidence": confidence, "reason": reason,
           "native_session_id": (data.get("native", {}).get("session_id") if verbose and data else None),
           "revision": data.get("revision") if data else None, "warnings": []}
    print(json.dumps(out) if "--json" in sys.argv[1:] else (str(path) if path else ""))
if bool(agent) != bool(native_id) or (agent and agent not in ("claude", "codex")):
    emit(None, None, "none", "invalid_input"); raise SystemExit(3)
records = []
malformed = False
unsupported = False
unsafe_path = False
for base in (session_dir, session_dir / "done"):
    if base.is_dir():
        for p in base.glob("session-*.json"):
            if confined_session_path(str(p)) is None:
                unsafe_path = True
                continue
            d = load(p)
            if d is None: malformed = True
            elif isinstance(d.get("schema_version"), int) and d["schema_version"] > 1: unsupported = True
            else: records.append((p, d))
if native_id:
    if unsafe_path: emit(None, None, "none", "invalid_session_path"); raise SystemExit(4)
    if unsupported: emit(None, None, "none", "unsupported_schema"); raise SystemExit(4)
    if malformed: emit(None, None, "none", "malformed_record"); raise SystemExit(4)
    matches = [(p,d) for p,d in records if d.get("schema_version") == 1 and
               d.get("project", {}).get("identity") == project_id and d.get("agent") == agent and
               d.get("native", {}).get("session_id") == native_id]
    if len(matches) > 1:
        active_matches = [(p, d) for p, d in matches if "done" not in p.parts and d.get("lifecycle", {}).get("state") != "complete"]
        if len(active_matches) == 1:
            matches = active_matches
        else:
            emit(None, None, "ambiguous", "duplicate_native_id"); raise SystemExit(2)
    if len(matches) == 1:
        p,d = matches[0]
        if "done" in p.parts or d.get("lifecycle", {}).get("state") == "complete":
            emit(None, None, "none", "ended_record"); raise SystemExit(3)
        emit(p,d,"exact","native_id"); raise SystemExit(0)
    cross = [(p,d) for p,d in records if d.get("schema_version") == 1 and d.get("agent") == agent and d.get("native", {}).get("session_id") == native_id]
    emit(None, None, "none", "cross_project" if cross else "not_found"); raise SystemExit(3 if cross else 1)
env_file = os.environ.get("RIG_SESSION_FILE")
if "RIG_SESSION_FILE" in os.environ:
    p = confined_session_path(env_file)
    d = load(p) if p else None
    state = d.get("lifecycle", {}).get("state", d.get("status")) if d else None
    if p and d and state == "active" and "done" not in p.parts: emit(p, d, "exact", "launcher_file"); raise SystemExit(0)
    emit(None, None, "none", "invalid_launcher_file"); raise SystemExit(3)
# Claude Code and Codex both expose native session identity through process
# environment variables, and every subprocess they spawn (hooks, and every
# ad-hoc tool-call shell) inherits those values via normal fork/exec — unlike
# RIG_SESSION_FILE/ANCHOR, which a hook script can only export into its own
# short-lived process, or the PID-sentinel scheme below, which breaks once a
# caller is more than one process hop from the PID that wrote it (e.g. a
# tool-call shell nested inside the `bin/rig` interpreter and an embedded
# python3). This is a genuine native identity signal, not an inferred one, so
# it is tried before the legacy anchor/PID fallbacks. A record naming a
# different project is a definitive cross_project answer, not a reason to keep
# guessing via PID. No matching v1 record at all is not a contradiction
# (older-schema records or a not-yet-native-bound project are still valid) so
# that case falls through unchanged to the legacy fallbacks below.
native_env_signals = []
if os.environ.get("CODEX_THREAD_ID"):
    native_env_signals.append(("codex", os.environ.get("CODEX_THREAD_ID")))
if os.environ.get("CLAUDE_CODE_SESSION_ID"):
    native_env_signals.append(("claude", os.environ.get("CLAUDE_CODE_SESSION_ID")))
for native_env_agent, native_env_id in native_env_signals:
    matches = [(p, d) for p, d in records if d.get("schema_version") == 1 and
               d.get("project", {}).get("identity") == project_id and d.get("agent") == native_env_agent and
               d.get("native", {}).get("session_id") == native_env_id]
    if len(matches) > 1:
        active_matches = [(p, d) for p, d in matches if "done" not in p.parts and d.get("lifecycle", {}).get("state") != "complete"]
        if len(active_matches) == 1:
            matches = active_matches
        else:
            emit(None, None, "ambiguous", "duplicate_native_id"); raise SystemExit(2)
    if len(matches) == 1:
        p, d = matches[0]
        if "done" in p.parts or d.get("lifecycle", {}).get("state") == "complete":
            emit(None, None, "none", "ended_record"); raise SystemExit(3)
        emit(p, d, "exact", "native_id"); raise SystemExit(0)
    cross = [(p, d) for p, d in records if d.get("schema_version") == 1 and d.get("agent") == native_env_agent and d.get("native", {}).get("session_id") == native_env_id]
    if cross: emit(None, None, "none", "cross_project"); raise SystemExit(3)
files = [(p,d) for p,d in records if "done" not in p.parts and d.get("lifecycle", {}).get("state", d.get("status")) == "active"]
explicit_anchor = "RIG_SESSION_ANCHOR" in os.environ
anchor = os.environ.get("RIG_SESSION_ANCHOR", "")
pid_text = os.environ.get("RIG_SESSION_PID") or str(os.getppid())
if not anchor and pid_text.isdigit():
    try: anchor = (pathlib.Path("/tmp") / (".rig-session-" + pid_text + ".uuid")).read_text().strip()
    except OSError: pass
if anchor:
    matches = [(p,d) for p,d in files if d.get("anchor") == anchor]
    if len(matches) == 1: emit(*matches[0], "exact", "anchor"); raise SystemExit(0)
    if len(matches) > 1: emit(None, None, "ambiguous", "duplicate_anchor"); raise SystemExit(2)
    if explicit_anchor: emit(None, None, "none", "launcher_anchor_not_found"); raise SystemExit(3)
elif explicit_anchor:
    emit(None, None, "none", "invalid_launcher_anchor"); raise SystemExit(3)
if pid_text.isdigit():
    direct = session_dir / ("session-" + pid_text + ".json"); d = load(direct)
    if d: emit(direct, d, "exact", "pid"); raise SystemExit(0)
emit(None, None, "none", "not_found"); raise SystemExit(1)
PY
}

session_bind() {
  RIG_ROOT="$(rig_root)" RIG_DIR="$(rig_dir)" python3 - "$@" <<'PY'
import datetime, fcntl, hashlib, json, os, pathlib, subprocess, sys, tempfile, uuid
args=sys.argv[1:]
def option(name, default=""):
    try: return args[args.index(name)+1]
    except (ValueError, IndexError): return default
agent=option("--agent"); native_id=option("--native-session-id"); source=option("--source", "hook")
root_native=option("--root-session-id") or native_id; parent=option("--parent-native-session-id") or None
native_title=option("--native-title") or None
allow_continuation="--allow-continuation" in args
if agent not in ("claude","codex") or not native_id:
    print(json.dumps({"ok":False,"reason":"invalid_input"})); raise SystemExit(3)
root=pathlib.Path(os.environ["RIG_ROOT"]).resolve(); rig=pathlib.Path(os.environ["RIG_DIR"]); sessions=rig/"memory"/"sessions"; sessions.mkdir(parents=True,exist_ok=True)
def confined_session_path(value):
    if not value:
        return None
    try:
        candidate=pathlib.Path(value)
        if not candidate.is_absolute(): candidate=pathlib.Path.cwd()/candidate
        sessions_root=sessions.resolve(); resolved=candidate.resolve(strict=False)
        resolved.relative_to(sessions_root)
        if resolved == sessions_root: return None
        probe=candidate
        while True:
            if probe.is_symlink():
                if probe == candidate: return None
                try:
                    probe.resolve(strict=False).relative_to(sessions_root)
                    return None
                except ValueError:
                    pass
            if probe.parent == probe: break
            probe=probe.parent
        if candidate.exists() and not candidate.is_file(): return None
        return resolved
    except (OSError,ValueError,RuntimeError):
        return None
lock=open(sessions/".bind.lock","a+"); fcntl.flock(lock.fileno(),fcntl.LOCK_EX)
try:
    common=subprocess.check_output(["git","-C",str(root),"rev-parse","--git-common-dir"],text=True,stderr=subprocess.DEVNULL).strip()
    common=pathlib.Path(common if os.path.isabs(common) else root/common).resolve()
except (OSError,subprocess.SubprocessError): common=root
project_id=hashlib.sha256(str(common).encode()).hexdigest(); now=datetime.datetime.now(datetime.timezone.utc).astimezone().isoformat(timespec="seconds")
def read(p):
    try:
        d=json.loads(p.read_text()); return d if isinstance(d,dict) else None
    except (OSError,ValueError,TypeError): return None
hint=os.environ.get("RIG_SESSION_FILE","")
hint_path=confined_session_path(hint) if hint else None
if hint and hint_path is None:
    print(json.dumps({"ok":False,"reason":"invalid_session_path","no_write":True})); raise SystemExit(3)
records=[]
unsafe_path=False
for base in (sessions,sessions/"done"):
    if base.is_dir():
        for p in base.glob("session-*.json"):
            if confined_session_path(str(p)) is None:
                unsafe_path=True
                continue
            d=read(p)
            if d is None:
                print(json.dumps({"ok":False,"reason":"malformed_record"})); raise SystemExit(4)
            if isinstance(d.get("schema_version"),int) and d["schema_version"]>1:
                print(json.dumps({"ok":False,"reason":"unsupported_schema"})); raise SystemExit(4)
            records.append((p,d))
if unsafe_path:
    print(json.dumps({"ok":False,"reason":"invalid_session_path","no_write":True})); raise SystemExit(4)
matches=[(p,d) for p,d in records if d.get("schema_version")==1 and d.get("project",{}).get("identity")==project_id and d.get("agent")==agent and d.get("native",{}).get("session_id")==native_id]
continuation_from_ended=False
if len(matches)>1:
    active_matches=[(p,d) for p,d in matches if "done" not in p.parts and d.get("lifecycle",{}).get("state")!="complete"]
    if len(active_matches)==1:
        matches=active_matches
    else:
        print(json.dumps({"ok":False,"reason":"duplicate_native_id"})); raise SystemExit(2)
if matches:
    p,d=matches[0]
    if hint_path and hint_path!=p.resolve():
        print(json.dumps({"ok":False,"reason":"native_conflict"})); raise SystemExit(3)
    if "done" in p.parts or d.get("lifecycle",{}).get("state")=="complete":
        if not allow_continuation:
            print(json.dumps({"ok":False,"reason":"ended_record"})); raise SystemExit(3)
        ended_path, ended_record = p, d
        continuation_from_ended=True
        if not parent:
            parent = ended_record.get("native", {}).get("session_id") or native_id
        matches = []
        p = None
        d = None
    elif d.get("lifecycle",{}).get("state") in ("conflict","superseded","repair_pending"):
        print(json.dumps({"ok":False,"reason":"invalid_lifecycle_transition"})); raise SystemExit(3)
if not matches:
    cross=[d for _,d in records if d.get("schema_version")==1 and d.get("agent")==agent and d.get("native",{}).get("session_id")==native_id]
    if cross and not continuation_from_ended:
        print(json.dumps({"ok":False,"reason":"cross_project"})); raise SystemExit(3)
    p=hint_path
    d=read(p) if p else None
    if d and d.get("schema_version")==1 and d.get("native",{}).get("session_id") not in (None,""):
        print(json.dumps({"ok":False,"reason":"native_conflict"})); raise SystemExit(3)
    if d and d.get("agent") not in (None,agent):
        print(json.dumps({"ok":False,"reason":"agent_conflict"})); raise SystemExit(3)
    anchor=(d or {}).get("anchor") or str(uuid.uuid4())
    if any(other.get("anchor")==anchor for op,other in records if p is None or op.resolve()!=p.resolve()):
        print(json.dumps({"ok":False,"reason":"duplicate_anchor"})); raise SystemExit(2)
    p=p or sessions/("session-"+anchor+".json")
    legacy=d or {}; created=legacy.get("created_at") or legacy.get("started_at") or now
    parent_matches=[other for _,other in records if other.get("schema_version")==1 and other.get("project",{}).get("identity")==project_id and other.get("agent")==agent and other.get("native",{}).get("session_id")==parent]
    if len(parent_matches)>1:
        print(json.dumps({"ok":False,"reason":"duplicate_native_id"})); raise SystemExit(2)
    parent_anchor=parent_matches[0].get("anchor") if len(parent_matches)==1 else None
    lineage_kind="continuation" if allow_continuation and parent_anchor else ("fork" if source=="fork" or parent else "root")
    d={"schema_version":1,"anchor":anchor,"agent":agent,
       "native":{"session_id":native_id,"root_session_id":root_native,"bound_at":now,"source":"launcher_hint" if hint else source},
       "project":{"root_realpath":str(root),"identity":project_id,"worktree_realpath":str(root)},
       "created_at":created,"updated_at":now,
       "runtime":{"pid":int(os.environ.get("RIG_SESSION_PID",os.getppid())),"launcher":"rig" if hint else "raw","cwd":os.getcwd(),"branch":"unknown","head":None},
       "lineage":{"parent_anchor":parent_anchor,"parent_native_session_id":parent,"kind":lineage_kind},
       "names":{"tentative":legacy.get("tentative_name"),"final":legacy.get("final_name"),"native_title":native_title,"display_title":legacy.get("final_name") or legacy.get("tentative_name") or native_title,"native_sync":"in-sync" if native_title and not (legacy.get("final_name") or legacy.get("tentative_name")) else ("suggested" if native_title else "unknown")},
       "lifecycle":{"state":"active","last_event":"session_start","last_event_at":now,"end_reason":None},
       "flags":{"wrap_needed":False,"post_merge_pending":False},
       "migration":{"legacy_anchor":legacy.get("anchor") if legacy else None,"legacy_pid":legacy.get("pid") if legacy else None,"migrated_at":now if legacy else None},"revision":1}
try: d["runtime"]["branch"]=subprocess.check_output(["git","-C",str(root),"rev-parse","--abbrev-ref","HEAD"],text=True,stderr=subprocess.DEVNULL).strip()
except (OSError,subprocess.SubprocessError): pass
if matches:
    d["updated_at"]=now; d["runtime"].update({"pid":int(os.environ.get("RIG_SESSION_PID",os.getppid())),"cwd":os.getcwd()}); d["project"]["worktree_realpath"]=str(root)
    d["lifecycle"].update({"state":"active","last_event":"session_start","last_event_at":now,"end_reason":None}); d["revision"]=int(d.get("revision",0))+1
    if native_title:
        names=d.setdefault("names",{}); names["native_title"]=native_title
        if not (names.get("final") or names.get("tentative") or names.get("display_title")): names["display_title"]=native_title
        names["native_sync"]="in-sync" if names.get("display_title")==native_title else "suggested"
fd,tmp=tempfile.mkstemp(prefix=".session-",suffix=".tmp",dir=str(p.parent))
try:
    with os.fdopen(fd,"w") as f: json.dump(d,f,indent=2); f.write("\n"); f.flush(); os.fsync(f.fileno())
    os.replace(tmp,p)
finally:
    try: os.unlink(tmp)
    except FileNotFoundError: pass
sentinel=pathlib.Path("/tmp")/(".rig-session-"+str(d["runtime"]["pid"])+".uuid")
try: sentinel.write_text(d["anchor"])
except OSError: pass
print(json.dumps({"ok":True,"schema_version":1,"session_file":str(p),"anchor":d["anchor"],"agent":agent,"state":"active","confidence":"exact","reason":"native_id","native_session_id":None,"revision":d["revision"],"warnings":[]}))
PY
}

session_retrofit() {
  local agent="" from_env=false source="resume" json=false arg native_id env_name resolved status
  while [[ "$#" -gt 0 ]]; do
    case "$1" in
      --agent) [[ "$#" -ge 2 ]] || { printf '{"ok":false,"reason":"invalid_input"}\n'; return 3; }; agent="$2"; shift 2;;
      --from-env) from_env=true; shift;;
      --source) [[ "$#" -ge 2 ]] || { printf '{"ok":false,"reason":"invalid_input"}\n'; return 3; }; source="$2"; shift 2;;
      --json) json=true; shift;;
      *) printf '{"ok":false,"reason":"invalid_input"}\n'; return 3;;
    esac
  done
  [[ "$agent" == codex || "$agent" == claude ]] || { printf '{"ok":false,"reason":"invalid_input"}\n'; return 3; }
  [[ "$from_env" == true ]] || { printf '{"ok":false,"reason":"invalid_input"}\n'; return 3; }
  case "$agent" in
    codex) env_name=CODEX_THREAD_ID; native_id="${CODEX_THREAD_ID:-}" ;;
    claude) env_name=CLAUDE_CODE_SESSION_ID; native_id="${CLAUDE_CODE_SESSION_ID:-}" ;;
  esac
  if [[ -z "$native_id" ]]; then
    printf '{"ok":false,"reason":"missing_native_env","agent":"%s","env":"%s","no_write":true}\n' "$agent" "$env_name"
    return 3
  fi
  resolved="$(session_resolve --json --agent "$agent" --native-session-id "$native_id")" && {
    if [[ "$json" == true ]]; then
      printf '%s\n' "$resolved" | python3 -c 'import json,sys; d=json.load(sys.stdin); d["retrofitted"]=False; print(json.dumps(d))'
    else
      printf 'Already bound current %s session.\n' "$agent"
    fi
    return 0
  }
  status=$?
  if [[ "$status" -ne 1 && "$status" -ne 3 ]]; then
    if [[ "$json" == true ]]; then printf '%s\n' "$resolved"; else printf 'Unable to retrofit current %s session.\n' "$agent" >&2; fi
    return "$status"
  fi
  if [[ "$status" -eq 3 ]] && ! printf '%s\n' "$resolved" | grep -Fq '"reason": "ended_record"'; then
    if [[ "$json" == true ]]; then printf '%s\n' "$resolved"; else printf 'Unable to retrofit current %s session.\n' "$agent" >&2; fi
    return "$status"
  fi
  bind_args=(session_bind --agent "$agent" --native-session-id "$native_id" --source "$source")
  if [[ "$status" -eq 3 ]]; then
    bind_args+=(--allow-continuation)
  fi
  resolved="$("${bind_args[@]}")"
  status=$?
  if [[ "$status" -eq 0 && "$json" == true ]]; then
    printf '%s\n' "$resolved" | python3 -c 'import json,sys; d=json.load(sys.stdin); d["retrofitted"]=True; print(json.dumps(d))'
  elif [[ "$status" -eq 0 ]]; then
    printf 'Bound current %s session.\n' "$agent"
  else
    printf '%s\n' "$resolved"
  fi
  return "$status"
}

session_current() {
  local json=false arg resolved original=("$@")
  for arg in "${original[@]}"; do [[ "$arg" == --json ]] && json=true; done
  while [[ "$#" -gt 0 ]]; do
    case "$1" in
      --json) json=true; shift;;
      --verbose) shift;;
      --agent|--native-session-id) [[ "$#" -ge 2 ]] || { printf '{"ok":false,"reason":"invalid_input"}\n'; return 3; }; shift 2;;
      *) [[ "$json" == true ]] && printf '{"ok":false,"reason":"invalid_input"}\n' || printf 'invalid_input\n' >&2; return 3;;
    esac
  done
  resolved=$(session_resolve --json "${original[@]}") || return $?
  if [[ "$json" == true ]]; then
    printf '%s\n' "$resolved"
  else
    printf '%s' "$resolved" | python3 -c 'import json,sys; d=json.load(sys.stdin); print("%s  %s  %s  %s" % (d.get("anchor") or "-", d.get("agent") or "legacy", d.get("state") or "unknown", d.get("branch") or "-"))'
  fi
}

session_inspect() {
  local action="$1"; shift
  RIG_ROOT="$(rig_root)" RIG_DIR="$(rig_dir)" python3 - "$action" "$@" <<'PY'
import hashlib, json, os, pathlib, stat, subprocess, sys
action=sys.argv[1]; args=sys.argv[2:]
if any(arg not in ("--json","--verbose") for arg in args):
    print(json.dumps({"ok":False,"reason":"invalid_input"}) if "--json" in args else "invalid_input"); raise SystemExit(3)
root=pathlib.Path(os.environ["RIG_ROOT"]).resolve(); sessions=pathlib.Path(os.environ["RIG_DIR"])/"memory"/"sessions"
verbose="--verbose" in args; as_json="--json" in args
def project_identity():
    try:
        common=subprocess.check_output(["git","-C",str(root),"rev-parse","--git-common-dir"],text=True,stderr=subprocess.DEVNULL).strip()
        common=pathlib.Path(common if os.path.isabs(common) else root/common).resolve()
    except (OSError,subprocess.SubprocessError): common=root
    return hashlib.sha256(str(common).encode()).hexdigest()
project_id=project_identity(); records=[]; errors=[]
for base in (sessions,sessions/"done"):
    if not base.is_dir(): continue
    for p in sorted(base.glob("session-*.json")):
        try:
            d=json.loads(p.read_text())
            if not isinstance(d,dict): raise ValueError("not an object")
            records.append((p,d))
        except (OSError,ValueError,TypeError): errors.append({"file":p.name,"reason":"malformed_record"})
def summary(p,d):
    names=d.get("names",{}); lifecycle=d.get("lifecycle",{}); runtime=d.get("runtime",{}); project=d.get("project",{})
    out={"anchor":d.get("anchor"),"agent":d.get("agent") or "legacy","state":lifecycle.get("state",d.get("status","unknown")),
         "project_matches":project.get("identity") in (None,project_id),"worktree":project.get("worktree_realpath"),
         "branch":runtime.get("branch",d.get("branch")),"name":names.get("final") or names.get("tentative") or d.get("final_name") or d.get("tentative_name"),
         "revision":d.get("revision"),"location":"done" if "done" in p.parts else "active"}
    if verbose: out["native_session_id"]=d.get("native",{}).get("session_id")
    return out
if action=="list":
    rows=[summary(p,d) for p,d in records]
    if as_json: print(json.dumps({"ok":not errors,"sessions":rows,"errors":errors}))
    else:
        for row in rows: print("{anchor}  {agent}  {state}  {branch}  {name}".format(**{k:(v if v is not None else "-") for k,v in row.items()}))
        for error in errors: print("ERROR  %s  %s"%(error["file"],error["reason"]),file=sys.stderr)
    raise SystemExit(0 if not errors else 2)
if action=="doctor":
    checks=[]
    def check(name,ok,detail): checks.append({"name":name,"ok":bool(ok),"detail":detail})
    check("record_syntax",not errors,"valid" if not errors else "%d malformed"%len(errors))
    future=[p.name for p,d in records if isinstance(d.get("schema_version"),int) and d["schema_version"]>1]
    check("schema_support",not future,"supported" if not future else "%d future schema"%len(future))
    invalid=[]
    for p,d in records:
        if d.get("schema_version")==1 and not (d.get("anchor") and d.get("agent") in ("claude","codex") and d.get("native",{}).get("session_id") and d.get("project",{}).get("identity") and d.get("lifecycle",{}).get("state") and isinstance(d.get("revision"),int)):
            invalid.append(p.name)
    check("v1_required_fields",not invalid,"present" if not invalid else "%d invalid"%len(invalid))
    anchors={}; natives={}
    for p,d in records:
        anchors.setdefault(d.get("anchor"),[]).append(p.name)
        native=d.get("native",{}).get("session_id")
        if native: natives.setdefault((d.get("project",{}).get("identity"),d.get("agent"),native),[]).append(p.name)
    dup_a=[k for k,v in anchors.items() if k and len(v)>1]; dup_n=[k for k,v in natives.items() if len(v)>1]
    check("unique_anchors",not dup_a,"unique" if not dup_a else "%d duplicates"%len(dup_a))
    check("unique_native_bindings",not dup_n,"unique" if not dup_n else "%d duplicates"%len(dup_n))
    audit=sessions/"repair-audit.jsonl"; audit_ok=True; audit_detail="absent"
    if audit.exists():
        audit_detail="valid"
        try:
            if stat.S_IMODE(audit.stat().st_mode) & 0o077: audit_ok=False; audit_detail="permissions too broad"
            for line in audit.read_text().splitlines():
                item=json.loads(line)
                if any(key in item for key in ("prompt","transcript","native_session_id")): audit_ok=False; audit_detail="sensitive field present"
        except (OSError,ValueError,TypeError): audit_ok=False; audit_detail="malformed"
    check("repair_audit_privacy",audit_ok,audit_detail)
    result={"ok":all(c["ok"] for c in checks),"checks":checks,"errors":errors}
    if as_json: print(json.dumps(result))
    else:
        for c in checks: print(("PASS" if c["ok"] else "FAIL")+"  "+c["name"]+": "+c["detail"])
    raise SystemExit(0 if result["ok"] else 2)
raise SystemExit(3)
PY
}

session_repair() {
  RIG_ROOT="$(rig_root)" RIG_DIR="$(rig_dir)" python3 - "$@" <<'PY'
import datetime, fcntl, hashlib, json, os, pathlib, subprocess, sys, tempfile
args=sys.argv[1:]
valued={"--anchor","--agent","--native-session-id","--reason","--confirm","--exported-text"}; flags={"--json","--authorize-last-resort","--match-prompt","--match-transcript"}
i=0
while i<len(args):
    if args[i] in flags: i+=1; continue
    if args[i] in valued and i+1<len(args): i+=2; continue
    print(json.dumps({"ok":False,"reason":"invalid_input"}) if "--json" in args else "invalid_input"); raise SystemExit(3)
def option(name):
    try: return args[args.index(name)+1]
    except (ValueError,IndexError): return ""
anchor=option("--anchor"); agent=option("--agent"); native_id=option("--native-session-id"); reason=option("--reason"); confirm=option("--confirm")
as_json="--json" in args
last_resort=any(x in args for x in ("--authorize-last-resort","--exported-text","--match-prompt","--match-transcript"))
def emit(ok,why,extra=None,code=0):
    out={"ok":ok,"reason":why}; out.update(extra or {})
    print(json.dumps(out) if as_json else (why+((": "+str(extra)) if extra else "")))
    raise SystemExit(code)
if last_resort:
    if "--authorize-last-resort" not in args: emit(False,"last_resort_not_authorized",code=3)
    emit(False,"documented_export_surface_unavailable",{"no_write":True},4)
if not anchor or agent not in ("claude","codex") or not native_id: emit(False,"invalid_input",code=3)
if reason and (len(reason)>120 or native_id in reason or anchor in reason): emit(False,"unsafe_reason",{"no_write":True},3)
root=pathlib.Path(os.environ["RIG_ROOT"]).resolve(); sessions=pathlib.Path(os.environ["RIG_DIR"])/"memory"/"sessions"; sessions.mkdir(parents=True,exist_ok=True)
try:
    common=subprocess.check_output(["git","-C",str(root),"rev-parse","--git-common-dir"],text=True,stderr=subprocess.DEVNULL).strip(); common=pathlib.Path(common if os.path.isabs(common) else root/common).resolve()
except (OSError,subprocess.SubprocessError): common=root
project_id=hashlib.sha256(str(common).encode()).hexdigest(); lock=open(sessions/".bind.lock","a+"); fcntl.flock(lock.fileno(),fcntl.LOCK_EX)
def safe_record_path(path):
    try:
        path.resolve(strict=False).relative_to(sessions.resolve())
        return path.is_file() and not path.is_symlink()
    except (OSError,ValueError,RuntimeError):
        return False
records=[]
for base in (sessions,sessions/"done"):
    if not base.is_dir(): continue
    for p in base.glob("session-*.json"):
        if not safe_record_path(p):
            emit(False,"invalid_session_path",{"no_write":True},4)
        try: d=json.loads(p.read_text())
        except (OSError,ValueError,TypeError): emit(False,"malformed_record",{"no_write":True},4)
        if isinstance(d.get("schema_version"),int) and d["schema_version"]>1: emit(False,"unsupported_schema",{"no_write":True},4)
        records.append((p,d))
candidates=[(p,d) for p,d in records if d.get("anchor")==anchor]
if len(candidates)!=1: emit(False,"not_found" if not candidates else "duplicate_anchor",{"no_write":True},1 if not candidates else 2)
p,d=candidates[0]
try:
    candidate=p.resolve(strict=False); candidate.relative_to(sessions.resolve())
    if p.is_symlink() or not p.is_file(): emit(False,"invalid_session_path",{"no_write":True},3)
except (OSError,ValueError,RuntimeError):
    emit(False,"invalid_session_path",{"no_write":True},3)
if "done" in p.parts or d.get("lifecycle",{}).get("state")=="complete": emit(False,"ended_record",{"no_write":True},3)
if d.get("project",{}).get("identity") not in (None,project_id): emit(False,"cross_project",{"no_write":True},3)
bound=d.get("native",{}).get("session_id")
if bound and bound!=native_id: emit(False,"native_conflict",{"no_write":True},3)
if bound==native_id: emit(True,"already_bound",{"anchor":anchor,"no_write":True})
if d.get("agent") not in (None,agent): emit(False,"agent_conflict",{"no_write":True},3)
collisions=[q for q,o in records if q!=p and o.get("schema_version")==1 and o.get("project",{}).get("identity")==project_id and o.get("agent")==agent and o.get("native",{}).get("session_id")==native_id]
if collisions: emit(False,"duplicate_native_id",{"no_write":True},2)
record_hash=hashlib.sha256(p.read_bytes()).hexdigest(); confirmation_token=hashlib.sha256((anchor+"\0"+native_id+"\0"+record_hash).encode()).hexdigest()[:16]
preview={"anchor":anchor,"agent":agent,"native_session_id":"redacted","record":p.name,"changes":{"native.session_id":"set","native.source":"repair","lifecycle.state":"active"},"confirmation_token":confirmation_token,"no_write":True}
if not confirm: emit(True,"repair_preview",preview)
if confirm!=confirmation_token or not reason: emit(False,"confirmation_required",preview,3)
before_bytes=p.read_bytes(); previous_hash=hashlib.sha256(before_bytes).hexdigest(); previous_revision=int(d.get("revision",0)); now=datetime.datetime.now(datetime.timezone.utc).astimezone().isoformat(timespec="seconds")
if d.get("schema_version")!=1: emit(False,"migration_required",{"no_write":True},4)
d.setdefault("native",{}).update({"session_id":native_id,"root_session_id":d.get("native",{}).get("root_session_id") or native_id,"bound_at":now,"source":"repair"})
d["agent"]=agent; d["updated_at"]=now; d.setdefault("lifecycle",{}).update({"state":"active","last_event":"repair","last_event_at":now,"end_reason":None}); d["revision"]=previous_revision+1
fd,tmp=tempfile.mkstemp(prefix=".session-",suffix=".tmp",dir=str(p.parent))
try:
    with os.fdopen(fd,"w") as f: json.dump(d,f,indent=2); f.write("\n"); f.flush(); os.fsync(f.fileno())
    os.replace(tmp,p)
finally:
    try: os.unlink(tmp)
    except FileNotFoundError: pass
audit={"timestamp":now,"action":"bind_orphan","anchor_hash":hashlib.sha256(anchor.encode()).hexdigest()[:16],"native_id_hash":hashlib.sha256(native_id.encode()).hexdigest()[:16],"previous_hash":previous_hash,"previous_revision":previous_revision,"new_revision":d["revision"],"reason":reason}
audit_path=sessions/"repair-audit.jsonl"; audit_lock=open(str(audit_path)+".lock","a+"); fcntl.flock(audit_lock.fileno(),fcntl.LOCK_EX)
audit_fd=os.open(audit_path,os.O_WRONLY|os.O_CREAT|os.O_APPEND,0o600); os.chmod(audit_path,0o600)
with os.fdopen(audit_fd,"a") as f: f.write(json.dumps(audit,separators=(",",":"))+"\n"); f.flush(); os.fsync(f.fileno())
emit(True,"repair_applied",{"anchor":anchor,"revision":d["revision"],"audit":"repair-audit.jsonl"})
PY
}

session_name_set() {
  local tentative=false complete=false json=false name="" arg resolved file anchor done_dir dest="" end_options=false
  for arg in "$@"; do
    if [[ "$end_options" == false ]]; then
      case "$arg" in
        --) end_options=true; continue;; --tentative) tentative=true; continue;;
        --final) tentative=false; continue;; --complete) complete=true; continue;; --json) json=true; continue;;
        -*) usage_error "unknown session-name option: $arg" "$@"; return;;
      esac
    fi
    [[ -z "$name" ]] || { usage_error "session name must be one argument" "$@"; return; }
    name="$arg"
  done
  [[ -n "$name" ]] || { usage_error "session name is required" "$@"; return; }
  resolved=$(session_resolve --json) || return $?
  file=$(printf '%s' "$resolved" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("session_file") or "")')
  anchor=$(printf '%s' "$resolved" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("anchor") or "")')
  [[ -n "$file" ]] || return "$RIG_EXIT_UNAVAILABLE"
  if [[ "$complete" == true ]]; then done_dir="$(rig_dir)/memory/sessions/done"; mkdir -p "$done_dir"; dest="$done_dir/session-$(date +%Y%m%d)-${anchor:-unknown}.json"; fi
  SESSION_F="$file" SESSION_NAME="$name" SESSION_TENTATIVE="$tentative" SESSION_COMPLETE="$complete" SESSION_DEST="$dest" python3 <<'PY'
import fcntl, json, os, tempfile
p = os.environ["SESSION_F"]
lock=open(p+".lock","a+"); fcntl.flock(lock.fileno(),fcntl.LOCK_EX)
with open(p) as f: d = json.load(f)
if d.get("schema_version") == 1:
    names=d.setdefault("names", {})
    if os.environ["SESSION_TENTATIVE"] == "true": names["tentative"] = os.environ["SESSION_NAME"]
    else: names["final"] = os.environ["SESSION_NAME"]; names["tentative"] = None
    names["display_title"] = os.environ["SESSION_NAME"]
    names["native_sync"] = "in-sync" if names.get("native_title") == os.environ["SESSION_NAME"] else "suggested"
    if os.environ["SESSION_COMPLETE"] == "true": d["lifecycle"]["state"] = "complete"
    d["revision"] = int(d.get("revision", 0)) + 1
else:
    if os.environ["SESSION_TENTATIVE"] == "true": d["tentative_name"] = os.environ["SESSION_NAME"]
    else: d["final_name"] = os.environ["SESSION_NAME"]; d["tentative_name"] = None
    if os.environ["SESSION_COMPLETE"] == "true": d["status"] = "complete"
dest = os.environ["SESSION_DEST"] or p
fd, tmp = tempfile.mkstemp(prefix=".session-", suffix=".tmp", dir=os.path.dirname(dest))
try:
    with os.fdopen(fd, "w") as f: json.dump(d, f, indent=2); f.write("\n"); f.flush(); os.fsync(f.fileno())
    os.replace(tmp, dest)
    if dest != p:
        try: os.unlink(p)
        except FileNotFoundError: pass
    pid=d.get("runtime", {}).get("pid", d.get("pid"))
    if os.environ["SESSION_COMPLETE"] == "true" and str(pid).isdigit():
        try: os.unlink("/tmp/.rig-session-" + str(pid) + ".uuid")
        except FileNotFoundError: pass
finally:
    try: os.unlink(tmp)
    except FileNotFoundError: pass
PY
  [[ "$json" == true ]] && printf '{"ok":true,"session_file":"%s"}\n' "${dest:-$file}"
  return 0
}

launch_claude() {
  local resolved watcher session_dir session_file session_anchor branch started
  # The launcher is the authority for a new Claude process. Create its identity
  # before the SessionStart hook so the watcher and hook share the exact file.
  export RIG_SESSION_PID="${RIG_SESSION_PID:-$$}"
  local resolve_status=0
  resolved=$(session_resolve --json) || resolve_status=$?
  if [[ "$resolve_status" -ne 0 ]]; then
    [[ "$resolve_status" -eq 1 ]] || { printf 'rig: unable to resolve an unambiguous Claude session\n' >&2; return "$RIG_EXIT_UNAVAILABLE"; }
    session_dir="$(rig_dir)/memory/sessions"; mkdir -p "$session_dir"
    session_anchor=$(python3 -c 'import uuid; print(str(uuid.uuid4())[:8])')
    session_file="$session_dir/session-${RIG_SESSION_PID}-${session_anchor}.json"
    branch=$(git -C "$(rig_root)" rev-parse --abbrev-ref HEAD 2>/dev/null || printf unknown)
    started=$(date -Iseconds 2>/dev/null || date +%Y-%m-%dT%H:%M:%S)
    SESSION_F="$session_file" SESSION_ANCHOR="$session_anchor" SESSION_PID="$RIG_SESSION_PID" SESSION_BRANCH="$branch" SESSION_STARTED="$started" python3 <<'PY'
import json, os
with open(os.environ["SESSION_F"], "x") as f:
    json.dump({"anchor": os.environ["SESSION_ANCHOR"], "pid": int(os.environ["SESSION_PID"]),
               "started_at": os.environ["SESSION_STARTED"], "branch": os.environ["SESSION_BRANCH"],
               "tentative_name": None, "final_name": None, "status": "active"}, f, indent=2)
    f.write("\n")
PY
    export RIG_SESSION_FILE="$session_file" RIG_SESSION_ANCHOR="$session_anchor"
    resolved=$(session_resolve --json)
  fi
  export RIG_SESSION_FILE RIG_SESSION_ANCHOR RIG_SESSION_PID RIG_PROJECT_NAME
  RIG_SESSION_FILE=$(printf '%s' "$resolved" | python3 -c 'import json,sys; print(json.load(sys.stdin)["session_file"])')
  RIG_SESSION_ANCHOR=$(printf '%s' "$resolved" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("anchor") or "")')
  RIG_SESSION_PID="${RIG_SESSION_PID:-$PPID}"; RIG_PROJECT_NAME="${RIG_PROJECT_NAME:-$(basename "$(rig_root)")}"
  watcher="$(dirname "${BASH_SOURCE[0]}")/rig-tab-title-watch"; [[ -x "$watcher" ]] && "$watcher" >/dev/null 2>&1 &
  [[ "${1:-}" == -- ]] && shift
  exec claude "$@"
}

launch_codex() {
  export RIG_SESSION_PID="${RIG_SESSION_PID:-$$}"
  [[ "${1:-}" == -- ]] && shift
  exec codex "$@"
}

main() {
  local command="${1:-}" subcommand
  case "$command" in
    ""|-h|--help) usage;;
    -v|--version|version) [[ "$command" == version ]] && shift; version "$@";;
    claude) shift; if [[ "${1:-}" == -h || "${1:-}" == --help ]]; then command_help claude; else launch_claude "$@"; fi;;
    codex) shift; if [[ "${1:-}" == -h || "${1:-}" == --help ]]; then command_help codex; else launch_codex "$@"; fi;;
    doctor) shift; if [[ "${1:-}" == -h || "${1:-}" == --help ]]; then command_help doctor; else doctor "$@"; fi;;
    connector) shift; if [[ "${1:-}" == -h || "${1:-}" == --help ]]; then command_help connector; else exec "$(dirname "${BASH_SOURCE[0]}")/rig-connector-preflight" "$@"; fi;;
    worktree) shift; if [[ "${1:-}" == -h || "${1:-}" == --help ]]; then command_help worktree; else worktree_bootstrap "$@"; fi;;
    sprint) shift; if [[ "${1:-}" == -h || "${1:-}" == --help ]]; then command_help sprint; else exec "$(dirname "${BASH_SOURCE[0]}")/rig-sprint" "$@"; fi;;
    session|session-name|memory)
      shift
      if [[ "${1:-}" == -h || "${1:-}" == --help ]]; then command_help "$command"; return; fi
      subcommand="${1:-}"; shift || true
      case "$command:$subcommand" in session:resolve) session_resolve "$@";; session:bind) session_bind "$@";; session:retrofit) session_retrofit "$@";; session:current) session_current "$@";; session:list) session_inspect list "$@";; session:doctor) session_inspect doctor "$@";; session:repair) session_repair "$@";; session:obligation) session_obligation "$@";; session-name:set) session_name_set "$@";; memory:validate) memory_markers validate "$@";; memory:repair-markers) memory_markers repair-markers "$@";; memory:append-gap) memory_append_gap "$@";; memory:append-progress) memory_append_progress "$@";; memory:write-snapshot) memory_write_snapshot "$@";; *) usage_error "unexpected $command subcommand" "$@";; esac;;
    *) shift; usage_error "unknown command: $command" "$@";;
  esac
}
main "$@"
