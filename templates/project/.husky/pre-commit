#!/bin/sh
# pre-commit
#
# Two checks run on every commit:
#
#   1. Secret scanning via gitleaks (requires install: brew install gitleaks),
#      unless CLAUDE.md sets `secret-scanner: none`
#   2. Debug artifact scanning — blocks commits containing leftover debug code
#
# Both checks scan staged files only.
# To bypass in an emergency: git commit --no-verify
#
# NOTE: Git hooks run with a stripped PATH. Never assume `command -v` will
# find a binary that works in your interactive shell. Always check known
# install locations explicitly.
#
# NOTE (Git 2.39+): Do NOT call `git add` inside a hook to stage files. In
# Git 2.39+ this triggers a "fatal: cannot lock ref" error because the index
# is already locked by the in-progress commit. Use `git update-index --add`
# to stage individual files if a hook needs to modify the index.

# ── 1. Secret scanning ────────────────────────────────────────────────────────
#
# CLAUDE.md `secret-scanner:` selects the scanner. `none` turns scanning off.
# A missing setting, `gitleaks`, or any other value keeps the gitleaks check,
# so a typo or a duplicate line can never silently disable scanning.

SECRET_SCANNER=gitleaks
HOOK_ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || HOOK_ROOT=""
if [ -n "$HOOK_ROOT" ] && [ -f "$HOOK_ROOT/CLAUDE.md" ]; then
  SCANNER_VALUE=$(awk '
    /^[[:space:]]*secret-scanner[[:space:]]*:/ {
      count++
      value = $0
      sub(/^[[:space:]]*secret-scanner[[:space:]]*:[[:space:]]*/, "", value)
      sub(/[[:space:]]+#.*/, "", value)
      sub(/[[:space:]]+$/, "", value)
      values[count] = tolower(value)
    }
    END {
      if (count == 0) print "__missing__"
      else if (count > 1) print "__duplicate__"
      else print values[1]
    }
  ' "$HOOK_ROOT/CLAUDE.md" 2>/dev/null)
  if [ "$SCANNER_VALUE" = "none" ]; then
    SECRET_SCANNER=none
  elif [ "$SCANNER_VALUE" != "gitleaks" ] && [ "$SCANNER_VALUE" != "__missing__" ]; then
    echo "WARNING: CLAUDE.md secret-scanner: is not exactly one well-formed 'gitleaks' or 'none' value; running gitleaks."
  fi
fi

GITLEAKS_BIN=""

if command -v gitleaks >/dev/null 2>&1; then
  GITLEAKS_BIN="gitleaks"
elif [ "${RIG_GITLEAKS_PATH_ONLY:-0}" != "1" ] && [ -x "/usr/local/bin/gitleaks" ]; then
  GITLEAKS_BIN="/usr/local/bin/gitleaks"
elif [ "${RIG_GITLEAKS_PATH_ONLY:-0}" != "1" ] && [ -x "/opt/homebrew/bin/gitleaks" ]; then
  GITLEAKS_BIN="/opt/homebrew/bin/gitleaks"
fi

if [ "$SECRET_SCANNER" = none ]; then
  echo "Secret scanning disabled (CLAUDE.md secret-scanner: none)."
elif [ -n "$GITLEAKS_BIN" ]; then
  if [ ! -f ".gitleaks.toml" ]; then
    echo ""
    echo "gitleaks configuration error — .gitleaks.toml is missing."
    echo "Secret scanning is enabled, but the configured file was not found."
    echo "Restore .gitleaks.toml or update this hook before committing."
    exit 1
  fi

  GITLEAKS_OUTPUT=$(mktemp) || exit 1
  "$GITLEAKS_BIN" protect --staged --config .gitleaks.toml --no-banner > "$GITLEAKS_OUTPUT" 2>&1
  GITLEAKS_STATUS=$?
  if [ "$GITLEAKS_STATUS" -ne 0 ]; then
    cat "$GITLEAKS_OUTPUT"
    if grep -qiE '(^|[[:space:]])(Finding:|RuleID:|Secret:|Commit:|Entropy:)' "$GITLEAKS_OUTPUT"; then
      echo ""
      echo "gitleaks blocked this commit — secrets detected in staged files."
      echo "Review the findings above, remove the secret, and re-stage."
      echo "If it is a known false positive, add it to .gitleaks.toml allowlist."
    elif grep -qiE 'failed to (load|open|read) config|invalid config|could not .*config|config .*not found|no such file or directory|permission denied|toml:' "$GITLEAKS_OUTPUT"; then
      echo ""
      echo "gitleaks configuration error — secret scanning could not run."
      echo "Review the gitleaks output above, then fix .gitleaks.toml or the gitleaks installation."
    else
      echo ""
      echo "gitleaks blocked this commit — secrets detected in staged files."
      echo "Review the findings above, remove the secret, and re-stage."
      echo "If it is a known false positive, add it to .gitleaks.toml allowlist."
    fi
    rm -f "$GITLEAKS_OUTPUT"
    exit 1
  fi
  rm -f "$GITLEAKS_OUTPUT"
else
  echo "WARNING: gitleaks not installed — secret scanning skipped."
  echo "Install it to protect yourself: brew install gitleaks"
fi

# ── 2. Debug artifact scanning ────────────────────────────────────────────────
#
# Blocks commits that contain leftover debug code.
# Scans staged file content only — not the working tree.
#
# Built-in patterns cover the most common debug statements across languages.
# Add project-specific patterns to .rig-debug-patterns (one grep-E pattern
# per line, lines starting with # are ignored).
#
# To allow a specific line through: append  # rig-debug-ok  to that line.
# To skip this check for one commit: git commit --no-verify

# Built-in debug patterns (grep -E syntax, one per line)
BUILTIN_PATTERNS="console\.log\(
debugger;
var_dump\(
print_r\(
error_log\(
file_put_contents.*debug
pdb\.set_trace\(
breakpoint\(
binding\.pry
byebug
System\.out\.println\(
(^|[^a-zA-Z0-9_])dd\(
dump\(.*=>>"

# Merge with project-specific patterns if present
ALL_PATTERNS="$BUILTIN_PATTERNS"
if [ -f ".rig-debug-patterns" ]; then
  EXTRA=$(grep -v '^#' .rig-debug-patterns | grep -v '^$')
  if [ -n "$EXTRA" ]; then
    ALL_PATTERNS="$ALL_PATTERNS
$EXTRA"
  fi
fi

# Load project-specific path exclusions (.rig-debug-scan-exclude)
# One glob pattern per line (e.g. vendor/**, templates/project/.husky/*). # lines ignored.
RIG_SCAN_EXCLUDES=""
if [ -f ".rig-debug-scan-exclude" ]; then
  RIG_SCAN_EXCLUDES=$(grep -v '^#' .rig-debug-scan-exclude | grep -v '^$' || true)
fi

# Build a single combined regex (patterns joined with |)
COMBINED=$(printf '%s\n' "$ALL_PATTERNS" | grep -v '^$' | tr '\n' '|' | sed 's/|$//')

if [ -z "$COMBINED" ]; then
  exit 0
fi

# Scan staged text files using NUL-delimited Git paths. Git C-quotes names
# containing quotes, backslashes, tabs and newlines in ordinary --name-only
# output, which would let the debug scan silently skip them.
RIG_SCAN_REGEX="$COMBINED" RIG_SCAN_EXCLUDES="$RIG_SCAN_EXCLUDES" python3 - <<'RIG_SCAN_PY'
import fnmatch
import os
import subprocess
import sys


def git(*args):
    return subprocess.run(["git", *args], stdout=subprocess.PIPE, stderr=subprocess.PIPE)


names = git("diff", "--cached", "--name-only", "--diff-filter=ACM", "-z")
if names.returncode:
    print("Debug artifact check could not read staged paths.", file=sys.stderr)
    sys.exit(1)

excluded = [line for line in os.environ["RIG_SCAN_EXCLUDES"].splitlines() if line]
binary_ext = (".png", ".jpg", ".jpeg", ".gif", ".ico", ".svg", ".woff",
              ".woff2", ".ttf", ".eot", ".pdf", ".zip", ".tar", ".gz",
              ".mp4", ".mp3", ".mov")
excluded_dirs = (".husky/", ".claude/hooks/", ".claude/commands/",
                 ".claude/agents/", ".rig/processes/")
findings = []
for raw in names.stdout.split(b"\0"):
    if not raw:
        continue
    name = os.fsdecode(raw)
    if name.endswith(binary_ext) or name.startswith(excluded_dirs):
        continue
    if any(fnmatch.fnmatchcase(name, pattern) for pattern in excluded):
        continue
    staged = git("show", ":" + name)
    if staged.returncode:
        print("Debug artifact check could not read staged file: " + repr(name), file=sys.stderr)
        sys.exit(1)
    scan = subprocess.run(["grep", "-nE", os.environ["RIG_SCAN_REGEX"]],
                          input=staged.stdout, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    if scan.returncode not in (0, 1):
        print("Debug artifact scan failed: " + scan.stderr.decode(errors="replace"), file=sys.stderr)
        sys.exit(1)
    hits = [line.decode(errors="replace") for line in scan.stdout.splitlines()
            if b"rig-debug-ok" not in line][:5]
    if hits:
        findings.append((name, hits))

if findings:
    print("\nDebug artifact check blocked this commit.")
    print("Remove or clean up the following before committing:")
    for name, hits in findings:
        print("  " + repr(name) + ":")
        for hit in hits:
            print("    " + hit)
    print("\n  To allow a specific line: append  # rig-debug-ok  to that source line")
    print("  To skip this check once: git commit --no-verify\n")
    sys.exit(1)
RIG_SCAN_PY
