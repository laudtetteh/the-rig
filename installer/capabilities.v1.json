{
  "schema": "https://the-rig.dev/schemas/installer-capabilities/v1",
  "schema_version": 1,
  "capabilities": [
    {
      "id": "global-claude-context",
      "layer": "global",
      "agents": ["claude"],
      "artifacts": [
        {"path": "CLAUDE.md", "type": "file", "required": true},
        {"path": "skills", "type": "dir", "required": true}
      ],
      "dependencies": ["claude"],
      "smoke": [{"id": "global-claude-md", "type": "exists", "target": "CLAUDE.md", "required": true}]
    },
    {
      "id": "project-rig-core",
      "layer": "project",
      "always": true,
      "agents": ["claude", "codex"],
      "artifacts": [
        {"path": "bin/rig", "type": "file", "required": true},
        {"path": "bin/rig-connector-preflight", "type": "file", "required": true},
        {"path": "bin/rig-sprint", "type": "file", "required": true},
        {"path": "bin/rig-tab-title-watch", "type": "file", "required": true}
      ],
      "dependencies": ["git"],
      "smoke": [{"id": "rig-dispatcher", "type": "executable", "target": "bin/rig", "required": true}]
    },
    {
      "id": "project-claude-integration",
      "layer": "project",
      "agents": ["claude"],
      "artifacts": [{"path": ".claude/settings.json", "type": "file", "required": true}],
      "dependencies": ["claude"],
      "smoke": [{"id": "claude-settings", "type": "exists", "target": ".claude/settings.json", "required": true}]
    },
    {
      "id": "project-codex-instructions",
      "layer": "project",
      "agents": ["codex"],
      "artifacts": [
        {"path": "CLAUDE.md", "type": "file", "required": true},
        {"path": ".codex/config.toml", "type": "file", "required": true},
        {"path": ".codex/hooks.json", "type": "file", "required": true},
        {"path": ".codex/hooks/rig-adapter.sh", "type": "file", "required": true},
        {"path": ".agents/skills", "type": "dir", "required": true}
      ],
      "dependencies": ["codex"],
      "smoke": [
        {"id": "codex-claude-fallback", "type": "exists", "target": ".codex/config.toml", "required": true},
        {"id": "codex-project-brain", "type": "exists", "target": "CLAUDE.md", "required": true},
        {"id": "codex-hooks", "type": "exists", "target": ".codex/hooks.json", "required": true},
        {"id": "codex-adapter", "type": "executable", "target": ".codex/hooks/rig-adapter.sh", "required": true},
        {"id": "codex-skills", "type": "exists", "target": ".agents/skills", "required": true}
      ]
    }
  ]
}
