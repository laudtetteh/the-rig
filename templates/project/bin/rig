#!/usr/bin/env bash
set -euo pipefail

readonly RIG_EXIT_USAGE=64
readonly RIG_EXIT_UNAVAILABLE=69

usage() { cat <<'EOF'
Usage: rig <command> [subcommand] [options]

Commands:
  rig doctor                Diagnose a Rig installation
  rig session resolve       Resolve the current session identity
  rig session-name set      Set the current session name atomically
  rig memory validate       Validate Rig memory files
  rig memory repair-markers Reposition unambiguous Rig memory markers
  rig codex                 Launch Codex with Rig context
  rig claude                Launch Claude Code with Rig context
  rig version               Print the installed Rig version
EOF
}
json_requested() { local arg; for arg in "$@"; do [[ "$arg" == --json ]] && return 0; done; return 1; }
rig_root() { cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd; }
rig_dir() {
  local root path; root="$(rig_root)"
  if [[ -f "$root/.rigpath" ]]; then
    IFS= read -r path < "$root/.rigpath" || true
    if [[ -n "$path" ]]; then case "$path" in /*) printf '%s\n' "$path";; *) printf '%s\n' "$root/$path";; esac; return; fi
  fi
  printf '%s\n' "$root/.rig"
}
version() {
  local value=unknown file; file="$(rig_dir)/VERSION"
  [[ -f "$file" ]] && { IFS= read -r value < "$file" || true; }; [[ -n "$value" ]] || value=unknown
  if json_requested "$@"; then printf '{"version":"%s"}\n' "$value"; else printf 'The Rig v%s\n' "$value"; fi
}
command_help() {
  case "$1" in
    doctor) printf 'Usage: rig doctor [--json]\n';;
    session) printf 'Usage: rig session resolve [--json]\n';;
    session-name) printf 'Usage: rig session-name set [--tentative|--final] [--complete] [--json] <name>\n';;
    memory) printf 'Usage: rig memory <validate|repair-markers> [--json]\n';;
    codex) printf 'Usage: rig codex [-- <codex arguments>]\n';;
    claude) printf 'Usage: rig claude [-- <claude arguments>]\n';;
  esac
}
unavailable() { local command="$1"; shift; if json_requested "$@"; then printf '{"ok":false,"command":"%s","error":"not_implemented"}\n' "$command"; else printf 'rig: %s is not implemented in this version\n' "$command" >&2; fi; return "$RIG_EXIT_UNAVAILABLE"; }
usage_error() { local message="$1"; shift; if json_requested "$@"; then printf '{"ok":false,"error":"usage","message":"%s"}\n' "$message"; else printf 'rig: %s\nTry "rig --help" for usage.\n' "$message" >&2; fi; return "$RIG_EXIT_USAGE"; }

memory_markers() {
  local action="$1" arg
  shift
  for arg in "$@"; do
    [[ "$arg" == --json ]] || { usage_error "unknown memory option: $arg" "$@"; return; }
  done
  RIG_DIR="$(rig_dir)" MEMORY_ACTION="$action" python3 - "$@" <<'PY'
import json, os, pathlib, re, stat, sys, tempfile

rig_dir = pathlib.Path(os.environ["RIG_DIR"])
action = os.environ["MEMORY_ACTION"]
json_output = "--json" in sys.argv[1:]
date_heading = re.compile(r"^##\s+(?:\[)?(\d{4}-\d{2}-\d{2})(?:\])?(?:\s|$)")

specs = (
    ("PROGRESS.md", "<!-- Add entries above this line, newest first -->", "above"),
    ("ERRORS.md", "<!-- Add new entries below this line, newest first -->", "below"),
)

def inspect(name, marker, direction):
    path = rig_dir / "memory" / name
    result = {"file": name, "ok": False, "marker_line": None,
              "first_entry_line": None, "issues": []}
    try:
        text = path.read_text()
    except OSError as exc:
        result["issues"].append("unreadable: " + str(exc))
        return path, None, result, None

    lines = text.splitlines(keepends=True)
    marker_indexes = [i for i, line in enumerate(lines) if line.rstrip("\r\n") == marker]
    marker_like = [i for i, line in enumerate(lines)
                   if "Add " in line and "entries" in line and "newest first" in line]
    format_indexes = []
    entries = []
    fenced = False
    for index, line in enumerate(lines):
        stripped = line.rstrip("\r\n")
        if stripped.startswith("```"):
            fenced = not fenced
            continue
        if fenced:
            continue
        if stripped == "## Format":
            format_indexes.append(index)
        match = date_heading.match(stripped)
        if match:
            entries.append((index, match.group(1)))

    if len(marker_indexes) != 1:
        result["issues"].append("marker_missing" if not marker_indexes else "marker_duplicated")
    if len(marker_like) != len(marker_indexes):
        result["issues"].append("marker_ambiguous")
    if len(format_indexes) != 1:
        result["issues"].append("format_missing" if not format_indexes else "format_duplicated")

    marker_index = marker_indexes[0] if len(marker_indexes) == 1 else None
    format_index = format_indexes[0] if len(format_indexes) == 1 else None
    result["marker_line"] = marker_index + 1 if marker_index is not None else None
    result["first_entry_line"] = entries[0][0] + 1 if entries else None

    if format_index is not None and marker_index is not None and marker_index <= format_index:
        result["issues"].append("marker_before_format")
    if entries:
        if format_index is not None and entries[0][0] <= format_index:
            result["issues"].append("entry_before_format")
        if marker_index is not None:
            indexes = [item[0] for item in entries]
            correctly_placed = marker_index > max(indexes) if direction == "above" else marker_index < min(indexes)
            if not correctly_placed:
                result["issues"].append("marker_mispositioned")
        dates = [item[1] for item in entries]
        if dates != sorted(dates, reverse=True):
            result["issues"].append("entries_not_newest_first")

    result["ok"] = not result["issues"]
    return path, lines, result, (marker_index, format_index, entries, marker)

def repair(path, lines, result, parsed):
    if result["ok"] or lines is None or parsed is None:
        return False
    marker_index, format_index, entries, marker = parsed
    repairable = result["issues"] == ["marker_mispositioned"]
    if not repairable or marker_index is None or format_index is None or not entries:
        return False

    marker_line = lines.pop(marker_index)
    if not marker_line.endswith(("\n", "\r")):
        newline = "\r\n" if any(line.endswith("\r\n") for line in lines) else "\n"
        marker_line += newline
    entry_indexes = [index - (1 if index > marker_index else 0) for index, _ in entries]
    if path.name == "PROGRESS.md":
        target = len(lines)
        for index in range(max(entry_indexes) + 1, len(lines)):
            if lines[index].startswith("## "):
                target = index
                break
    else:
        target = min(entry_indexes)
    lines.insert(target, marker_line)

    original_mode = stat.S_IMODE(path.stat().st_mode)
    fd, temporary = tempfile.mkstemp(prefix=".memory-marker-", dir=path.parent)
    try:
        with os.fdopen(fd, "w") as handle:
            handle.writelines(lines)
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(temporary, original_mode)
        os.replace(temporary, path)
    finally:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass
    return True

inspections = []
for name, marker, direction in specs:
    inspections.append(inspect(name, marker, direction))

changed = []
if action == "repair-markers":
    safe = all(result["ok"] or result["issues"] == ["marker_mispositioned"]
               for _, _, result, _ in inspections)
    if safe:
        for path, lines, result, parsed in inspections:
            if repair(path, lines, result, parsed):
                changed.append(path.name)

results = [inspect(name, marker, direction)[2] for name, marker, direction in specs]

ok = all(result["ok"] for result in results)
payload = {"ok": ok, "command": "memory " + action, "changed": changed, "files": results}
if json_output:
    print(json.dumps(payload, separators=(",", ":")))
else:
    for result in results:
        if result["ok"]:
            print("PASS  " + result["file"])
        else:
            print("WARN  " + result["file"] + ": " + ", ".join(result["issues"]))
    if changed:
        print("Repositioned markers: " + ", ".join(changed))
raise SystemExit(0 if ok else 1)
PY
}

doctor() {
  local arg
  for arg in "$@"; do
    [[ "$arg" == --json ]] || { usage_error "unknown doctor option: $arg" "$@"; return; }
  done
  RIG_ROOT="$(rig_root)" RIG_DIR="$(rig_dir)" python3 - "$@" <<'PY'
import json, os, pathlib, re, subprocess, sys

try:
    import tomllib
except ImportError:
    tomllib = None

root = pathlib.Path(os.environ["RIG_ROOT"])
rig = pathlib.Path(os.environ["RIG_DIR"])
checks = []

def check(name, ok, detail):
    checks.append({"name": name, "ok": bool(ok), "detail": str(detail)})

def read(path):
    try:
        return path.read_text(errors="replace")
    except OSError:
        return ""

def run(command):
    try:
        return subprocess.run(command, cwd=root, text=True, capture_output=True, timeout=10)
    except (OSError, subprocess.SubprocessError) as exc:
        return None

# Path resolution must be both usable and recognisably a Rig data directory.
marker = rig / "memory"
check("rig_directory", rig.is_dir() and os.access(rig, os.R_OK) and marker.is_dir(),
      f"resolved {rig}" if rig.is_dir() else f"missing {rig}")
rigpath = root / ".rigpath"
if rigpath.exists():
    raw_text = read(rigpath)
    raw = raw_text.strip()
    check("rigpath", bool(raw) and len(raw_text.splitlines()) == 1 and rig.is_dir(),
          f"resolves to {rig}" if raw else "empty .rigpath")
else:
    check("rigpath", rig == root / ".rig", "using local .rig")

# Stealth exclusions are required only for stealth installs. Future Codex paths
# become required when the corresponding integration is detectable.
if rigpath.exists():
    exclude = read(root / ".git" / "info" / "exclude").splitlines()
    entries = {line.strip().rstrip("/") for line in exclude if line.strip() and not line.lstrip().startswith("#")}
    required = ["CLAUDE.md", "PROJECT_BRIEF.md", ".claude", ".rigpath"]
    for candidate in [".agents", ".codex", ".mcp.json", ".playwright-mcp"]:
        if (root / candidate).exists(): required.append(candidate)
    missing = [item for item in required if item.rstrip("/") not in entries]
    check("stealth_exclusions", not missing, "complete" if not missing else "missing: " + ", ".join(missing))
else:
    check("stealth_exclusions", True, "not a stealth install")

json_files = [root / ".claude" / "settings.json"]
hooks = root / ".codex" / "hooks.json"
if hooks.exists(): json_files.append(hooks)
bad_json = []
for path in json_files:
    try:
        with path.open() as handle: json.load(handle)
    except (OSError, ValueError) as exc:
        bad_json.append(f"{path.relative_to(root)}: {exc}")
check("settings_json", not bad_json, "valid" if not bad_json else "; ".join(bad_json))

# The per-install manifest records exactly which optional commands were selected.
manifest = rig / "memory" / ".rig-manifest"
expected = []
for line in read(manifest).splitlines():
    fields = line.split(None, 1)
    if len(fields) == 2 and fields[1].startswith(".claude/commands/") and fields[1].endswith(".md"):
        expected.append(fields[1])
command_dir = root / ".claude" / "commands"
if expected:
    missing = [item for item in expected if not (root / item).is_file()]
    detail = f"{len(expected) - len(missing)}/{len(expected)} manifest commands present"
else:
    present = sorted(command_dir.glob("*.md")) if command_dir.is_dir() else []
    missing = [] if present else [".claude/commands/*.md"]
    detail = f"{len(present)} commands present (no manifest baseline)"
check("claude_commands", not missing, detail if not missing else "missing: " + ", ".join(missing))

skills = root / ".agents" / "skills"
if skills.is_dir():
    command_names = {p.stem for p in command_dir.glob("*.md")}
    skill_names = {p.parent.name for p in skills.glob("*/SKILL.md")}
    missing_skills = sorted(command_names - skill_names)
    extra_skills = sorted(skill_names - command_names)
    check("codex_skill_parity", not missing_skills and not extra_skills,
          f"{len(skill_names)}/{len(command_names)} mirrored" if not missing_skills and not extra_skills
          else "missing skills: " + (", ".join(missing_skills) or "none") + "; extra skills: " + (", ".join(extra_skills) or "none"))
else:
    check("codex_skill_parity", True, "Codex mirroring not enabled")

# Codex target metadata makes project-instruction visibility a required health
# check. AGENTS.override.md and AGENTS.md take precedence; CLAUDE.md is effective
# only when the project config names it as a fallback.
target_state = rig / "install-targets.json"
try:
    target_agents = json.loads(read(target_state)).get("agents", [])
except (AttributeError, TypeError, ValueError):
    target_agents = []
if "codex" in target_agents:
    agents_file = next((name for name in ("AGENTS.override.md", "AGENTS.md")
                        if (root / name).is_file()), None)
    fallback_ok = False
    config_error = None
    config_path = root / ".codex" / "config.toml"
    if tomllib is not None:
        try:
            with config_path.open("rb") as handle:
                fallback_names = tomllib.load(handle).get("project_doc_fallback_filenames", [])
            fallback_ok = isinstance(fallback_names, list) and "CLAUDE.md" in fallback_names and (root / "CLAUDE.md").is_file()
        except (OSError, tomllib.TOMLDecodeError) as exc:
            config_error = str(exc)
    else:
        config_text = read(config_path)
        match = re.search(r'(?ms)^[ \t]*project_doc_fallback_filenames[ \t]*=[ \t]*\[(.*?)\]', config_text)
        if match:
            fallback_names = re.findall(r'["\']([^"\']+)["\']', match.group(1))
            fallback_ok = "CLAUDE.md" in fallback_names and (root / "CLAUDE.md").is_file()
        else:
            config_error = "project_doc_fallback_filenames missing or malformed"
    effective = bool(agents_file) or fallback_ok
    if agents_file:
        detail = f"{agents_file} takes precedence"
    elif fallback_ok:
        detail = "CLAUDE.md loaded through project_doc_fallback_filenames"
    else:
        detail = "no effective AGENTS file or CLAUDE.md fallback"
        if config_error:
            detail += ": " + config_error
    check("codex_project_instructions", effective, detail)
else:
    check("codex_project_instructions", True, "Codex project target not enabled")

claude_md = read(root / "CLAUDE.md")
matches = re.findall(r"(?m)^issue-tracking:\s*([^\s#]+)", claude_md)
tracker = matches[-1].lower() if matches else "github"
supported = {"github", "linear", "trello", "gus", "none"}
check("issue_tracking", len(matches) <= 1 and tracker in supported,
      f"configured: {tracker}" if tracker in supported else f"unsupported: {tracker}")

if tracker == "github":
    auth = run(["gh", "auth", "status"])
    authenticated = auth is not None and auth.returncode == 0
    check("github_auth", authenticated, "authenticated" if authenticated else "gh authentication unavailable")
else:
    check("github_auth", True, f"not required for {tracker}")

# Command guidance is checked separately from repository history: command files
# must describe the selected tracker, while commits use the generic reference
# syntax. PR titles are not required to carry commit-only [#N] suffixes.
guidance = read(command_dir / "task.md") + "\n" + read(command_dir / "ship.md")
tokens = {"github": "issue-tracking: github", "linear": "issue-tracking: linear",
          "trello": "issue-tracking: trello", "gus": "issue-tracking: gus", "none": "issue-tracking: none"}
check("tracker_command_guidance", tokens.get(tracker, "") in guidance,
      f"command guidance covers {tracker}" if tokens.get(tracker, "") in guidance else f"command guidance missing {tracker}")

log = run(["git", "log", "-20", "--pretty=%s"])
subjects = log.stdout.splitlines() if log is not None and log.returncode == 0 else []
if tracker == "github": pattern = re.compile(r"\[#\d+\]")
elif tracker == "linear": pattern = re.compile(r"\b[A-Z][A-Z0-9]+-\d+\b")
elif tracker == "trello": pattern = re.compile(r"\btrello:[A-Za-z0-9_-]+\b", re.I)
elif tracker == "gus": pattern = re.compile(r"\bW-\d+\b", re.I)
else: pattern = None
if pattern and subjects:
    drift = [subject for subject in subjects if not pattern.search(subject)]
    check("recent_commit_references", not drift, f"{len(subjects)-len(drift)}/{len(subjects)} match {tracker}; first drift: {drift[0]}" if drift else f"{len(subjects)}/{len(subjects)} match {tracker}")
else:
    check("recent_commit_references", True, "no convention required" if pattern is None else "no commits to inspect")

# Query PRs only when this is a GitHub-backed checkout and auth already passed;
# this avoids surprising network activity in ordinary local/non-GitHub projects.
remote = run(["git", "remote", "get-url", "origin"])
remote_url = remote.stdout.strip() if remote is not None and remote.returncode == 0 else ""
if tracker == "github" and "github.com" in remote_url and authenticated:
    prs = run(["gh", "pr", "list", "--state", "all", "--limit", "20", "--json", "title,body"])
    try:
        pr_data = json.loads(prs.stdout) if prs is not None and prs.returncode == 0 else None
    except (TypeError, ValueError):
        pr_data = None
    if pr_data is None:
        check("recent_pr_references", False, "unable to inspect GitHub PRs")
    else:
        # A project may use conventional PR titles without the commit-only [#N]
        # suffix. Accept an issue reference or close keyword in either title/body.
        unlinked = [pr.get("title", "") for pr in pr_data
                    if not re.search(r"(?i)(?:\[#\d+\]|\b(?:closes|fixes|resolves)\s+#\d+\b)",
                                     pr.get("title", "") + "\n" + (pr.get("body") or ""))]
        check("recent_pr_references", not unlinked,
              f"{len(pr_data)-len(unlinked)}/{len(pr_data)} linked; first drift: {unlinked[0]}" if unlinked else f"{len(pr_data)}/{len(pr_data)} linked")
else:
    reason = "not a GitHub remote" if tracker == "github" else f"not required for {tracker}"
    check("recent_pr_references", True, reason)

result = {"ok": all(item["ok"] for item in checks), "command": "doctor", "root": str(root), "rig_dir": str(rig), "checks": checks}
if "--json" in sys.argv[1:]:
    print(json.dumps(result, separators=(",", ":")))
else:
    for item in checks:
        print(("PASS" if item["ok"] else "FAIL") + f"  {item['name']}: {item['detail']}")
    print("Rig doctor: " + ("healthy" if result["ok"] else "problems found"))
raise SystemExit(0 if result["ok"] else 1)
PY
}

session_resolve() {
  RIG_ROOT="$(rig_root)" RIG_DIR="$(rig_dir)" python3 - "$@" <<'PY'
import json, os, pathlib, subprocess, sys
root = pathlib.Path(os.environ["RIG_ROOT"])
session_dir = pathlib.Path(os.environ["RIG_DIR"]) / "memory" / "sessions"
def load(path):
    try:
        data = json.loads(path.read_text())
        if data.get("status") != "active" or "done" in path.parts: return None
        return data
    except (OSError, ValueError, TypeError): return None
def emit(path, data, confidence, reason):
    out = {"session_file": str(path) if path else None, "anchor": data.get("anchor") if data else None,
           "branch": data.get("branch") if data else None, "status": data.get("status") if data else None,
           "confidence": confidence, "reason": reason}
    print(json.dumps(out) if "--json" in sys.argv[1:] else (str(path) if path else ""))
env_file = os.environ.get("RIG_SESSION_FILE")
if "RIG_SESSION_FILE" in os.environ:
    p = pathlib.Path(env_file); d = load(p)
    if d: emit(p, d, "exact", "launcher_file"); raise SystemExit(0)
    emit(None, None, "none", "invalid_launcher_file"); raise SystemExit(3)
files = []
if session_dir.is_dir():
    for p in session_dir.glob("session-*.json"):
        d = load(p)
        if d: files.append((p, d))
explicit_anchor = "RIG_SESSION_ANCHOR" in os.environ
anchor = os.environ.get("RIG_SESSION_ANCHOR", "")
pid_text = os.environ.get("RIG_SESSION_PID") or str(os.getppid())
if not anchor and pid_text.isdigit():
    try: anchor = (pathlib.Path("/tmp") / (".rig-session-" + pid_text + ".uuid")).read_text().strip()
    except OSError: pass
if anchor:
    matches = [(p,d) for p,d in files if d.get("anchor") == anchor]
    if len(matches) == 1: emit(*matches[0], "exact", "anchor"); raise SystemExit(0)
    if len(matches) > 1: emit(None, None, "ambiguous", "duplicate_anchor"); raise SystemExit(2)
    if explicit_anchor: emit(None, None, "none", "launcher_anchor_not_found"); raise SystemExit(3)
elif explicit_anchor:
    emit(None, None, "none", "invalid_launcher_anchor"); raise SystemExit(3)
if pid_text.isdigit():
    direct = session_dir / ("session-" + pid_text + ".json"); d = load(direct)
    if d: emit(direct, d, "exact", "pid"); raise SystemExit(0)
branch = os.environ.get("RIG_SESSION_BRANCH", "")
if not branch:
    try: branch = subprocess.check_output(["git", "-C", str(root), "rev-parse", "--abbrev-ref", "HEAD"], text=True, stderr=subprocess.DEVNULL).strip()
    except (OSError, subprocess.SubprocessError): pass
matches = [(p,d) for p,d in files if d.get("status") == "active" and branch and d.get("branch") == branch]
if len(matches) == 1: emit(*matches[0], "inferred", "unique_active_branch"); raise SystemExit(0)
if len(matches) > 1 or len(files) > 1: emit(None, None, "ambiguous", "multiple_active_sessions"); raise SystemExit(2)
if len(files) == 1: emit(*files[0], "low", "only_active_session"); raise SystemExit(0)
emit(None, None, "none", "not_found"); raise SystemExit(1)
PY
}

session_name_set() {
  local tentative=false complete=false json=false name="" arg resolved file anchor done_dir dest="" end_options=false
  for arg in "$@"; do
    if [[ "$end_options" == false ]]; then
      case "$arg" in
        --) end_options=true; continue;; --tentative) tentative=true; continue;;
        --final) tentative=false; continue;; --complete) complete=true; continue;; --json) json=true; continue;;
        -*) usage_error "unknown session-name option: $arg" "$@"; return;;
      esac
    fi
    [[ -z "$name" ]] || { usage_error "session name must be one argument" "$@"; return; }
    name="$arg"
  done
  [[ -n "$name" ]] || { usage_error "session name is required" "$@"; return; }
  resolved=$(session_resolve --json) || return $?
  file=$(printf '%s' "$resolved" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("session_file") or "")')
  anchor=$(printf '%s' "$resolved" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("anchor") or "")')
  [[ -n "$file" ]] || return "$RIG_EXIT_UNAVAILABLE"
  if [[ "$complete" == true ]]; then done_dir="$(rig_dir)/memory/sessions/done"; mkdir -p "$done_dir"; dest="$done_dir/session-$(date +%Y%m%d)-${anchor:-unknown}.json"; fi
  SESSION_F="$file" SESSION_NAME="$name" SESSION_TENTATIVE="$tentative" SESSION_COMPLETE="$complete" SESSION_DEST="$dest" python3 <<'PY'
import json, os, tempfile
p = os.environ["SESSION_F"]
with open(p) as f: d = json.load(f)
if os.environ["SESSION_TENTATIVE"] == "true": d["tentative_name"] = os.environ["SESSION_NAME"]
else: d["final_name"] = os.environ["SESSION_NAME"]; d["tentative_name"] = None
if os.environ["SESSION_COMPLETE"] == "true": d["status"] = "complete"
dest = os.environ["SESSION_DEST"] or p
fd, tmp = tempfile.mkstemp(prefix=".session-", suffix=".tmp", dir=os.path.dirname(dest))
try:
    with os.fdopen(fd, "w") as f: json.dump(d, f, indent=2); f.write("\n"); f.flush(); os.fsync(f.fileno())
    os.replace(tmp, dest)
    if dest != p:
        try: os.unlink(p)
        except FileNotFoundError: pass
    if os.environ["SESSION_COMPLETE"] == "true" and str(d.get("pid", "")).isdigit():
        try: os.unlink("/tmp/.rig-session-" + str(d["pid"]) + ".uuid")
        except FileNotFoundError: pass
finally:
    try: os.unlink(tmp)
    except FileNotFoundError: pass
PY
  [[ "$json" == true ]] && printf '{"ok":true,"session_file":"%s"}\n' "${dest:-$file}"
  return 0
}

launch_claude() {
  local resolved watcher session_dir session_file session_anchor branch started
  # The launcher is the authority for a new Claude process. Create its identity
  # before the SessionStart hook so the watcher and hook share the exact file.
  export RIG_SESSION_PID="${RIG_SESSION_PID:-$$}"
  local resolve_status=0
  resolved=$(session_resolve --json) || resolve_status=$?
  if [[ "$resolve_status" -ne 0 ]]; then
    [[ "$resolve_status" -eq 1 ]] || { printf 'rig: unable to resolve an unambiguous Claude session\n' >&2; return "$RIG_EXIT_UNAVAILABLE"; }
    session_dir="$(rig_dir)/memory/sessions"; mkdir -p "$session_dir"
    session_anchor=$(python3 -c 'import uuid; print(str(uuid.uuid4())[:8])')
    session_file="$session_dir/session-${RIG_SESSION_PID}-${session_anchor}.json"
    branch=$(git -C "$(rig_root)" rev-parse --abbrev-ref HEAD 2>/dev/null || printf unknown)
    started=$(date -Iseconds 2>/dev/null || date +%Y-%m-%dT%H:%M:%S)
    SESSION_F="$session_file" SESSION_ANCHOR="$session_anchor" SESSION_PID="$RIG_SESSION_PID" SESSION_BRANCH="$branch" SESSION_STARTED="$started" python3 <<'PY'
import json, os
with open(os.environ["SESSION_F"], "x") as f:
    json.dump({"anchor": os.environ["SESSION_ANCHOR"], "pid": int(os.environ["SESSION_PID"]),
               "started_at": os.environ["SESSION_STARTED"], "branch": os.environ["SESSION_BRANCH"],
               "tentative_name": None, "final_name": None, "status": "active"}, f, indent=2)
    f.write("\n")
PY
    export RIG_SESSION_FILE="$session_file" RIG_SESSION_ANCHOR="$session_anchor"
    resolved=$(session_resolve --json)
  fi
  export RIG_SESSION_FILE RIG_SESSION_ANCHOR RIG_SESSION_PID RIG_PROJECT_NAME
  RIG_SESSION_FILE=$(printf '%s' "$resolved" | python3 -c 'import json,sys; print(json.load(sys.stdin)["session_file"])')
  RIG_SESSION_ANCHOR=$(printf '%s' "$resolved" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("anchor") or "")')
  RIG_SESSION_PID="${RIG_SESSION_PID:-$PPID}"; RIG_PROJECT_NAME="${RIG_PROJECT_NAME:-$(basename "$(rig_root)")}"
  watcher="$(dirname "${BASH_SOURCE[0]}")/rig-tab-title-watch"; [[ -x "$watcher" ]] && "$watcher" >/dev/null 2>&1 &
  [[ "${1:-}" == -- ]] && shift
  exec claude "$@"
}

launch_codex() {
  [[ "${1:-}" == -- ]] && shift
  exec codex "$@"
}

main() {
  local command="${1:-}" subcommand
  case "$command" in
    ""|-h|--help) usage;;
    -v|--version|version) [[ "$command" == version ]] && shift; version "$@";;
    claude) shift; if [[ "${1:-}" == -h || "${1:-}" == --help ]]; then command_help claude; else launch_claude "$@"; fi;;
    codex) shift; if [[ "${1:-}" == -h || "${1:-}" == --help ]]; then command_help codex; else launch_codex "$@"; fi;;
    doctor) shift; if [[ "${1:-}" == -h || "${1:-}" == --help ]]; then command_help doctor; else doctor "$@"; fi;;
    session|session-name|memory)
      shift
      if [[ "${1:-}" == -h || "${1:-}" == --help ]]; then command_help "$command"; return; fi
      subcommand="${1:-}"; shift || true
      case "$command:$subcommand" in session:resolve) session_resolve "$@";; session-name:set) session_name_set "$@";; memory:validate) memory_markers validate "$@";; memory:repair-markers) memory_markers repair-markers "$@";; *) usage_error "unexpected $command subcommand" "$@";; esac;;
    *) shift; usage_error "unknown command: $command" "$@";;
  esac
}
main "$@"
